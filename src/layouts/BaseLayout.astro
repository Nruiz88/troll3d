---
/**
 * BaseLayout.astro
 * Layout base para "La cueva del Troll"
 *
 * @see https://docs.astro.build/en/basics/layouts/
 * @see https://github.com/jonasǺ/astro-seo
 */

import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title = 'La cueva del Troll',
  description = 'Productos legendarios forjados en las profundidades de la cueva. Calidad que ningún humano puede resistir.',
  image = '/favicon.svg',
  canonicalURL = Astro.url,
  noindex = false,
  nofollow = false,
} = Astro.props;

const siteTitle = title.includes('La cueva del Troll') ? title : `${title} | La cueva del Troll`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Component (astro-seo) -->
    <SEO
      title={siteTitle}
      description={description}
      canonical={canonicalURL.toString()}
      noindex={noindex}
      nofollow={nofollow}
      openGraph={{
        basic: {
          title: siteTitle,
          type: 'website',
          image: new URL(image, Astro.url).toString(),
          url: Astro.url.toString(),
        },
        optional: {
          description: description,
          siteName: 'La cueva del Troll',
          locale: 'es_MX',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: siteTitle,
        description: description,
        image: new URL(image, Astro.url).toString(),
      }}
    />

    <!-- Client Router (navegación suave entre páginas) -->
    <ClientRouter />

    <!-- Security Meta Tags -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="X-XSS-Protection" content="1; mode=block" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
