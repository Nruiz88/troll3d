---
/**
 * AdminLayout.astro
 * Layout admin temático "La cueva del Troll" con navegación completa
 *
 * @see https://docs.astro.build/en/basics/layouts/
 */

import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import logoImage from '../../public/logo-troll.jpg';
import '../styles/admin.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Admin',
  description = 'Panel de administración de La cueva del Troll',
} = Astro.props;

const currentPath = Astro.url.pathname;

const mainNav = [
  { label: 'Dashboard', href: '/admin', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
];

const ecommerceNav = [
  { label: 'Productos', href: '/admin/products', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { label: 'Nuevo producto', href: '/admin/products/new', icon: 'M12 5v14m-7-7h14' },
  { label: 'Categorías', href: '/admin/categories', icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' },
];

const ordersNav = [
  { label: 'Pedidos', href: '/admin/orders', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
  { label: 'Clientes', href: '/admin/customers', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
];

const settingsNav = [
  { label: 'Configuración', href: '/admin/settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { label: 'Pagos', href: '/admin/settings/payments', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
  { label: 'Marketing', href: '/admin/marketing', icon: 'M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z' },
];

function isActive(href: string): boolean {
  if (href === '/admin') return currentPath === '/admin';
  return currentPath.startsWith(href);
}
---

<BaseLayout title={`${title} | La cueva del Troll`} description={description}>
  <div class="admin-layout">
    <div class="sidebar-overlay" id="sidebar-overlay"></div>
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <a href="/admin" class="sidebar-logo">
          <Image src={logoImage} alt="La cueva del Troll" class="logo-image" width={42} height={42} sizes="42px" />
          <div class="logo-text">
            <span class="logo-main">La cueva del</span>
            <span class="logo-highlight">Troll</span>
          </div>
        </a>
      </div>

      <nav class="sidebar-nav">
        <!-- Principal -->
        <div class="nav-section">
          <span class="nav-section-title">Principal</span>
          <ul class="nav-list">
            {mainNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive(item.href) }]}
                >
                  <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d={item.icon}></path>
                  </svg>
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- E-commerce -->
        <div class="nav-section">
          <span class="nav-section-title">⚔️ Tienda</span>
          <ul class="nav-list">
            {ecommerceNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive(item.href) }]}
                >
                  <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d={item.icon}></path>
                  </svg>
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Pedidos y Clientes -->
        <div class="nav-section">
          <span class="nav-section-title">📋 Pedidos</span>
          <ul class="nav-list">
            {ordersNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive(item.href) }]}
                >
                  <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d={item.icon}></path>
                  </svg>
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Configuración -->
        <div class="nav-section">
          <span class="nav-section-title">⚙️ Sistema</span>
          <ul class="nav-list">
            {settingsNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive(item.href) }]}
                >
                  <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d={item.icon}></path>
                  </svg>
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>

      <div class="sidebar-footer">
        <a href="/" class="nav-link" target="_blank">
          <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span class="nav-label">Ver tienda</span>
        </a>
        <button class="nav-link logout-btn" id="logout-btn">
          <Icon name="logout" class="nav-icon" width="20" height="20" />
          <span class="nav-label">Salir</span>
        </button>
      </div>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <div class="top-bar-left">
          <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Abrir menú">
            <Icon name="menu" width="24" height="24" />
          </button>
          <h1 class="page-title">{title}</h1>
        </div>
        <div class="top-bar-right">
          <a href="/" class="top-bar-link" target="_blank" aria-label="Ver tienda">
            <Icon name="external-link" width="18" height="18" />
          </a>
        </div>
      </header>

      <div class="page-content">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .admin-layout {
    display: flex;
    min-height: 100vh;
    background: var(--color-bg);
  }

  /* Sidebar */
  .sidebar {
    width: 260px;
    background: linear-gradient(180deg, var(--color-bg-secondary) 0%, var(--color-bg) 100%);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 100;
  }

  .sidebar-header {
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .logo-image {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    object-fit: cover;
    box-shadow: 0 0 12px rgba(255, 87, 34, 0.4);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-main {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .logo-highlight {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .sidebar-nav {
    flex: 1;
    padding: var(--space-6) var(--space-4);
    overflow-y: auto;
  }

  .nav-section {
    margin-bottom: var(--space-6);
  }

  .nav-section-title {
    display: block;
    padding: 0 var(--space-4);
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    width: 100%;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .nav-link:hover {
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .nav-link.active {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .nav-icon {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .nav-link.active .nav-icon {
    opacity: 1;
  }

  .sidebar-footer {
    padding: var(--space-4);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .logout-btn {
    cursor: pointer;
  }

  .logout-btn:hover {
    background: var(--color-error-light);
    color: var(--color-error);
  }

  /* Main Content */
  .main-content {
    flex: 1;
    margin-left: 260px;
    background: var(--color-bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .top-bar {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: 0 var(--space-8);
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .page-title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .top-bar-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-text-muted);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }

  .top-bar-link:hover {
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .page-content {
    flex: 1;
    padding: var(--space-8);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .sidebar {
      width: 72px;
    }

    .nav-label,
    .logo-text,
    .nav-section-title {
      display: none;
    }

    .sidebar-header {
      padding: var(--space-4);
      display: flex;
      justify-content: center;
    }

    .sidebar-logo {
      justify-content: center;
    }

    .nav-link {
      justify-content: center;
      padding: var(--space-3);
    }

    .sidebar-footer .nav-link {
      justify-content: center;
    }

    .main-content {
      margin-left: 72px;
    }
  }

  /* Mobile Sidebar Toggle */
  .sidebar-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    border-radius: var(--radius-lg);
  }

  .sidebar-toggle:hover {
    background: var(--color-bg-hover);
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 99;
  }

  .sidebar-overlay.open {
    display: block;
  }

  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
      transition: transform var(--transition-normal);
      width: 280px;
      z-index: 200;
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar-toggle {
      display: flex;
    }

    .nav-label,
    .logo-text,
    .nav-section-title {
      display: block;
    }

    .sidebar-header {
      padding: var(--space-4) var(--space-6);
    }

    .nav-link {
      justify-content: flex-start;
      padding: var(--space-3) var(--space-4);
    }

    .sidebar-footer .nav-link {
      justify-content: flex-start;
    }

    .main-content {
      margin-left: 0;
    }

    .top-bar {
      padding: 0 var(--space-4);
    }

    .page-content {
      padding: var(--space-4);
    }

    .page-title {
      font-size: var(--text-lg);
    }
  }
</style>

<script>
  // Mobile sidebar toggle
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const toggle = document.getElementById('sidebar-toggle');

  toggle?.addEventListener('click', () => {
    sidebar?.classList.toggle('open');
    overlay?.classList.toggle('open');
  });

  overlay?.addEventListener('click', () => {
    sidebar?.classList.remove('open');
    overlay?.classList.remove('open');
  });

  // Close sidebar on nav link click (mobile)
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 768) {
        sidebar?.classList.remove('open');
        overlay?.classList.remove('open');
      }
    });
  });

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    document.cookie = 'sb-access-token=; path=/; max-age=0';
    window.location.href = '/admin/login';
  });
</script>
