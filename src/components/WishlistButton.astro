---
/**
 * WishlistButton.astro
 * Botón de favoritos con toggle on/off
 * 
 * @see https://docs.astro.build/en/basics/astro-components/
 */

interface Props {
  productId: string;
  productName?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { productId, productName = '', size = 'md' } = Astro.props;
---

<button
  class:list={['wishlist-btn', size]}
  data-product-id={productId}
  data-product-name={productName}
  aria-label={`Agregar ${productName} a favoritos`}
  title="Agregar a favoritos"
>
  <svg class="heart-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>
  <svg class="heart-filled" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>
</button>

<style>
  .wishlist-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .wishlist-btn:hover {
    border-color: var(--color-error);
    color: var(--color-error);
    background: var(--color-error-light);
  }

  .wishlist-btn.active {
    border-color: var(--color-error);
    color: var(--color-error);
    background: var(--color-error-light);
  }

  .wishlist-btn.active .heart-icon {
    display: none;
  }

  .wishlist-btn.active .heart-filled {
    display: block;
    animation: heartBeat 0.4s ease;
  }

  .heart-icon,
  .heart-filled {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .heart-filled {
    display: none;
  }

  /* Sizes */
  .wishlist-btn.sm {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
  }

  .wishlist-btn.sm .heart-icon,
  .wishlist-btn.sm .heart-filled {
    width: 14px;
    height: 14px;
  }

  .wishlist-btn.md {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
  }

  .wishlist-btn.lg {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-xl);
  }

  .wishlist-btn.lg .heart-icon,
  .wishlist-btn.lg .heart-filled {
    width: 22px;
    height: 22px;
  }

  @keyframes heartBeat {
    0% { transform: scale(1); }
    25% { transform: scale(1.3); }
    50% { transform: scale(0.9); }
    100% { transform: scale(1); }
  }
</style>

<script>
  let supabase: any = null;

  async function getSupabase() {
    if (!supabase) {
      const { createClient } = await import('@supabase/supabase-js');
      supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );
    }
    return supabase;
  }

  // Check wishlist status on load
  async function checkWishlistStatus() {
    const client = await getSupabase();
    const { data: { user } } = await client.auth.getUser();
    if (!user) return;

    const btns = document.querySelectorAll('.wishlist-btn');
    for (const btn of btns) {
      const productId = (btn as HTMLElement).dataset.productId;
      const { data } = await client
        .from('wishlist')
        .select('id')
        .eq('customer_id', user.id)
        .eq('product_id', productId)
        .single();

      if (data) {
        btn.classList.add('active');
        (btn as HTMLElement).setAttribute('aria-label', `Quitar ${(btn as HTMLElement).dataset.productName} de favoritos`);
      }
    }
  }

  // Toggle wishlist
  document.querySelectorAll('.wishlist-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const target = e.currentTarget as HTMLButtonElement;
      const productId = target.dataset.productId;
      const productName = target.dataset.productName;

      const client = await getSupabase();
      const { data: { user } } = await client.auth.getUser();
      
      if (!user) {
        window.location.href = '/auth/login';
        return;
      }

      const isActive = target.classList.contains('active');

      if (isActive) {
        // Remove from wishlist
        const { error } = await client
          .from('wishlist')
          .delete()
          .eq('customer_id', user.id)
          .eq('product_id', productId);

        if (!error) {
          target.classList.remove('active');
          target.setAttribute('aria-label', `Agregar ${productName} a favoritos`);
        }
      } else {
        // Add to wishlist
        const { error } = await client
          .from('wishlist')
          .insert({ customer_id: user.id, product_id: productId });

        if (!error) {
          target.classList.add('active');
          target.setAttribute('aria-label', `Quitar ${productName} de favoritos`);
        }
      }
    });
  });

  checkWishlistStatus();
</script>
