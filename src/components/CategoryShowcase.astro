---
/**
 * CategoryShowcase.astro
 * Showcase de categorías en grande y atractivo
 * Prioriza la exploración visual del catálogo
 */

interface Category {
  id: string;
  name: string;
  slug: string;
  description?: string;
  image_url?: string;
  emoji?: string;
}

interface Props {
  categories: Category[];
  title?: string;
  subtitle?: string;
}

import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const {
  categories = [],
  title = "Explora nuestras categorías",
  subtitle = "Encuentra exactamente lo que buscas"
} = Astro.props;

// Emojis por tipo de categoría
const getEmoji = (name: string) => {
  const emojiMap: Record<string, string> = {
    'espadas': '⚔️',
    'escudos': '🛡️',
    'dragones': '🐉',
    'figuras': '🐲',
    'accesorios': '✨',
    'hogar': '🏰',
    'armas': '🔱',
    'ropa': '👕',
    'libros': '📚',
    'joyas': '💎',
    'artesanía': '🎨',
    'decoración': '🎭',
  };
  
  // Buscar coincidencia en la categoría
  const lowerName = name.toLowerCase();
  for (const [key, emoji] of Object.entries(emojiMap)) {
    if (lowerName.includes(key)) return emoji;
  }
  return '📦';
};
---

<section class="category-showcase">
  <div class="container">
    <!-- Header -->
    <div class="showcase-header">
      <div>
        <h2 class="showcase-title">{title}</h2>
        <p class="showcase-subtitle">{subtitle}</p>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="categories-showcase-grid">
      {categories.map((category, index) => (
        <a 
          href={`/shop?category=${category.slug}`} 
          class="category-showcase-card"
          style={`--delay: ${index * 0.05}s`}
        >
          <!-- Background Pattern -->
          <div class="card-bg-pattern"></div>
          
          <!-- Content -->
          <div class="card-content">
            {category.image_url ? (
              <div class="card-image-wrap">
                <Image
                  src={category.image_url}
                  alt={category.name}
                  class="card-image"
                  width={72}
                  height={72}
                  sizes="72px"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="card-emoji">{category.emoji || getEmoji(category.name)}</div>
            )}
            <h3 class="card-name">{category.name}</h3>
            {category.description && (
              <p class="card-description">{category.description}</p>
            )}
            <div class="card-cta">
              <span class="cta-text">Explorar</span>
              <Icon name="arrow-right" width="16" height="16" />
            </div>
          </div>
          
          <!-- Hover Glow -->
          <div class="card-glow"></div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .category-showcase {
    padding: var(--space-20) 0;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-secondary) 100%);
    position: relative;
    overflow: hidden;
  }

  .showcase-header {
    margin-bottom: var(--space-16);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
  }

  .showcase-title {
    font-size: var(--text-4xl);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .showcase-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  /* Grid */
  .categories-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  /* Card */
  .category-showcase-card {
    position: relative;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.05) 0%, rgba(255, 87, 34, 0.05) 100%);
    backdrop-filter: blur(10px);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    animation: slideUp 0.5s ease-out both;
    animation-delay: var(--delay, 0s);
    overflow: hidden;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .category-showcase-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 30%, rgba(76, 175, 80, 0.1) 0%, transparent 50%);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .category-showcase-card:hover::before {
    opacity: 1;
  }

  .card-bg-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(76, 175, 80, 0.03) 10px, rgba(76, 175, 80, 0.03) 20px);
    pointer-events: none;
  }

  .card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-emoji {
    font-size: 2.5rem;
    line-height: 1;
  }

  /* Imagen de categoría (cuando existe en la DB) */
  .card-image-wrap {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 2px solid var(--color-border);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-showcase-card:hover .card-image-wrap {
    border-color: var(--color-primary);
    transform: scale(1.06);
  }

  .card-name {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    transition: color var(--transition-base);
  }

  .card-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .card-cta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--color-primary);
    font-weight: var(--font-medium);
    font-size: var(--text-sm);
    transition: all var(--transition-base);
  }

  .cta-text {
    transition: transform var(--transition-base);
  }

  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(76, 175, 80, 0.2) 0%, transparent 70%);
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
    border-radius: var(--radius-2xl);
  }

  /* Hover State */
  .category-showcase-card:hover {
    border-color: var(--color-primary);
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.15) 0%, rgba(255, 87, 34, 0.08) 100%);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(76, 175, 80, 0.15);
  }

  .category-showcase-card:hover .card-name {
    color: var(--color-primary);
  }

  .category-showcase-card:hover .card-cta {
    gap: var(--space-3);
  }

  .category-showcase-card:hover .cta-text {
    transform: translateX(4px);
  }

  .category-showcase-card:hover .card-glow {
    opacity: 1;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .showcase-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .showcase-title {
      font-size: var(--text-3xl);
    }

    .categories-showcase-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }

    .category-showcase-card {
      padding: var(--space-6);
    }

    .card-emoji {
      font-size: 2rem;
    }

    .card-name {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 480px) {
    .categories-showcase-grid {
      grid-template-columns: 1fr;
    }

    .category-showcase-card {
      padding: var(--space-5);
    }
  }
</style>
