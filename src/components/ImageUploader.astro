---
/**
 * ImageUploader.astro
 * Componente reutilizable para subir imágenes a Supabase Storage
 * 
 * Props:
 * - id: Identificador único del componente
 * - bucket: Bucket de Supabase Storage (default: 'products')
 * - folder: Carpeta dentro del bucket
 * - multiple: Permitir múltiples imágenes
 * - maxFiles: Número máximo de archivos
 * - existingImages: Array de URLs existentes (para edición)
 */

interface Props {
  id: string;
  bucket?: string;
  folder?: string;
  multiple?: boolean;
  maxFiles?: number;
  existingImages?: string[];
}

const {
  id,
  bucket = 'products',
  folder = 'images',
  multiple = false,
  maxFiles = 5,
  existingImages = []
} = Astro.props;
---

<div class="image-uploader" id={id} data-bucket={bucket} data-folder={folder} data-max={maxFiles}>
  <!-- Drop Zone -->
  <div class="drop-zone" id={`${id}-dropzone`}>
    <div class="drop-content">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      <p class="drop-text">Arrastra imágenes aquí o</p>
      <label class="drop-btn">
        Seleccionar archivos
        <input 
          type="file" 
          class="file-input" 
          accept="image/*"
          multiple={multiple}
          data-input-id={id}
        />
      </label>
      <span class="drop-hint">PNG, JPG, WebP hasta 5MB</span>
    </div>
  </div>

  <!-- Preview Grid -->
  <div class="preview-grid" id={`${id}-preview`}>
    {existingImages.map((img, i) => (
      <div class="preview-item" data-url={img}>
        <img src={img} alt={`Imagen ${i + 1}`} loading="lazy" />
        <button type="button" class="remove-btn" data-index={i} aria-label="Eliminar imagen">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        {i === 0 && <span class="main-badge">Principal</span>}
      </div>
    ))}
  </div>

  <!-- Upload Progress -->
  <div class="upload-progress" id={`${id}-progress`} hidden>
    <div class="progress-bar">
      <div class="progress-fill" id={`${id}-progress-fill`}></div>
    </div>
    <span class="progress-text" id={`${id}-progress-text`}>Subiendo...</span>
  </div>

  <!-- Hidden Input for URLs -->
  <input type="hidden" name={`${id}-urls`} id={`${id}-urls`} value={existingImages.join(',')} />
</div>

<style>
  .image-uploader {
    width: 100%;
  }

  .drop-zone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .drop-zone:hover,
  .drop-zone.dragover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .drop-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
  }

  .drop-content svg {
    opacity: 0.5;
  }

  .drop-text {
    font-size: var(--text-sm);
    margin: 0;
  }

  .drop-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .drop-btn:hover {
    background: var(--color-primary-hover);
  }

  .file-input {
    display: none;
  }

  .drop-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .preview-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-item.uploading {
    opacity: 0.5;
  }

  .remove-btn {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(239, 68, 68, 0.9);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .preview-item:hover .remove-btn {
    opacity: 1;
  }

  .main-badge {
    position: absolute;
    bottom: var(--space-2);
    left: var(--space-2);
    padding: 2px var(--space-2);
    background: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 10px;
    font-weight: var(--font-medium);
    border-radius: var(--radius-md);
    text-transform: uppercase;
  }

  .upload-progress {
    margin-top: var(--space-4);
  }

  .progress-bar {
    height: 6px;
    background: var(--color-border);
    border-radius: 3px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-primary);
    border-radius: 3px;
    transition: width var(--transition-fast);
    width: 0%;
  }

  .progress-text {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>

<script>
  class ImageUploader {
    private container: HTMLElement;
    private dropzone: HTMLElement;
    private fileInput: HTMLInputElement;
    private previewGrid: HTMLElement;
    private progress: HTMLElement;
    private progressFill: HTMLElement;
    private progressText: HTMLElement;
    private hiddenInput: HTMLInputElement;
    private bucket: string;
    private folder: string;
    private maxFiles: number;
    private uploadedUrls: string[] = [];

    constructor(element: HTMLElement) {
      this.container = element;
      this.dropzone = element.querySelector('.drop-zone')!;
      this.fileInput = element.querySelector('.file-input')!;
      this.previewGrid = element.querySelector('.preview-grid')!;
      this.progress = element.querySelector('.upload-progress')!;
      this.progressFill = element.querySelector('.progress-fill')!;
      this.progressText = element.querySelector('.progress-text')!;
      this.hiddenInput = element.querySelector('input[type="hidden"]')!;
      
      this.bucket = element.dataset.bucket || 'products';
      this.folder = element.dataset.folder || 'images';
      this.maxFiles = parseInt(element.dataset.max || '5');

      // Load existing URLs
      const existing = this.hiddenInput.value;
      if (existing) {
        this.uploadedUrls = existing.split(',').filter(u => u);
      }

      this.init();
    }

    private init() {
      // File input change
      this.fileInput.addEventListener('change', (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files) this.handleFiles(files);
      });

      // Drag and drop
      this.dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzone.classList.add('dragover');
      });

      this.dropzone.addEventListener('dragleave', () => {
        this.dropzone.classList.remove('dragover');
      });

      this.dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzone.classList.remove('dragover');
        const files = e.dataTransfer?.files;
        if (files) this.handleFiles(files);
      });

      // Click on dropzone
      this.dropzone.addEventListener('click', () => {
        this.fileInput.click();
      });

      // Remove buttons
      this.previewGrid.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.remove-btn');
        if (btn) {
          const item = btn.closest('.preview-item');
          const url = (item as HTMLElement)?.dataset.url;
          if (url) {
            this.removeImage(url);
            (item as HTMLElement).remove();
          }
        }
      });
    }

    private async handleFiles(files: FileList) {
      const remaining = this.maxFiles - this.uploadedUrls.length;
      const filesToUpload = Array.from(files).slice(0, remaining);

      if (filesToUpload.length === 0) {
        alert(`Máximo ${this.maxFiles} imágenes permitidas`);
        return;
      }

      this.progress.hidden = false;

      for (let i = 0; i < filesToUpload.length; i++) {
        const file = filesToUpload[i];
        const progress = ((i + 1) / filesToUpload.length) * 100;
        this.progressFill.style.width = `${progress}%`;
        this.progressText.textContent = `Subiendo ${i + 1} de ${filesToUpload.length}...`;

        try {
          const url = await this.uploadFile(file);
          this.uploadedUrls.push(url);
          this.addPreview(url);
        } catch (err) {
          console.error('Upload error:', err);
        }
      }

      this.updateHiddenInput();
      this.progress.hidden = true;
      this.progressFill.style.width = '0%';
      this.fileInput.value = '';
    }

    private async uploadFile(file: File): Promise<string> {
      const { createClient } = await import('@supabase/supabase-js');
      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const fileName = `${this.folder}/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;

      const { data, error } = await supabase.storage
        .from(this.bucket)
        .upload(fileName, file, {
          cacheControl: '3600',
          upsert: false
        });

      if (error) throw error;

      const { data: urlData } = supabase.storage
        .from(this.bucket)
        .getPublicUrl(data.path);

      return urlData.publicUrl;
    }

    private addPreview(url: string) {
      const div = document.createElement('div');
      div.className = 'preview-item';
      div.dataset.url = url;
      div.innerHTML = `
        <img src="${url}" alt="Imagen subida" loading="lazy" />
        <button type="button" class="remove-btn" aria-label="Eliminar imagen">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        ${this.uploadedUrls.length === 1 ? '<span class="main-badge">Principal</span>' : ''}
      `;
      this.previewGrid.appendChild(div);
    }

    private removeImage(url: string) {
      this.uploadedUrls = this.uploadedUrls.filter(u => u !== url);
      this.updateHiddenInput();
    }

    private updateHiddenInput() {
      this.hiddenInput.value = this.uploadedUrls.join(',');
    }

    public getUrls(): string[] {
      return this.uploadedUrls;
    }
  }

  // Initialize all uploaders
  document.querySelectorAll('.image-uploader').forEach(el => {
    new ImageUploader(el as HTMLElement);
  });
</script>
