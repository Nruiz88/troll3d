---
/**
 * CartDrawer.astro
 * Drawer del carrito con diseño moderno y animaciones.
 *
 * @see https://docs.astro.build/en/basics/astro-components/
 */
---

<div class="cart-overlay" id="cart-overlay" hidden></div>

<aside class="cart-drawer" id="cart-drawer" aria-label="Carrito de compras">
  <header class="cart-header">
    <div class="cart-title-container">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <h2 class="cart-title">Tu carrito</h2>
    </div>
    <button class="cart-close" id="cart-close" aria-label="Cerrar carrito">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </header>

  <div class="cart-content" id="cart-content">
    <div class="cart-empty" id="cart-empty">
      <div class="empty-icon">🛒</div>
      <p class="empty-title">Tu carrito está vacío</p>
      <p class="empty-subtitle">Agrega productos para comenzar</p>
      <a href="/shop" class="btn-continue">Ir a la tienda</a>
    </div>

    <div class="cart-items" id="cart-items" hidden></div>
  </div>

  <footer class="cart-footer" id="cart-footer" hidden>
    <div class="cart-summary">
      <div class="summary-row">
        <span>Subtotal</span>
        <span id="cart-subtotal">$0.00</span>
      </div>
      <div class="summary-row shipping">
        <span>Envío</span>
        <span>Calculado en checkout</span>
      </div>
      <div class="summary-row total">
        <span>Total</span>
        <span id="cart-total">$0.00</span>
      </div>
    </div>
    <a href="/checkout" class="btn-checkout">
      <span>Ir a checkout</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </footer>
</aside>

<style>
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: var(--z-overlay);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .cart-overlay[hidden] {
    display: none;
  }

  .cart-overlay:not([hidden]) {
    opacity: 1;
    animation: overlayFade var(--transition-base) ease forwards;
  }

  @keyframes overlayFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 420px;
    max-width: 100%;
    background: var(--color-bg);
    box-shadow: var(--shadow-xl);
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--transition-slow);
  }

  .cart-drawer.open {
    transform: translateX(0);
  }

  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-title-container {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
  }

  .cart-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
  }

  .cart-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }

  .cart-close:hover {
    color: var(--color-text);
    background: var(--color-bg-tertiary);
  }

  .cart-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-6);
  }

  .cart-empty {
    text-align: center;
    padding: var(--space-12) var(--space-6);
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: var(--space-4);
    opacity: 0.5;
  }

  .empty-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .empty-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .btn-continue {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background: var(--color-primary);
    color: white;
    font-weight: var(--font-medium);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }

  .btn-continue:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cart-item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }

  .cart-item:hover {
    background: var(--color-bg-tertiary);
  }

  .cart-item-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .cart-item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cart-item-name {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: var(--space-1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-item-name:hover {
    color: var(--color-primary);
  }

  .cart-item-price {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .cart-item-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .qty-control {
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .qty-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .qty-btn:hover {
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .cart-item-qty {
    min-width: 40px;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text);
  }

  .remove-btn {
    margin-left: auto;
    padding: var(--space-2);
    color: var(--color-text-muted);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .remove-btn:hover {
    color: var(--color-error);
    background: var(--color-error-light);
  }

  .cart-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-6);
    background: var(--color-bg);
  }

  .cart-summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .summary-row.shipping {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .summary-row.total {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .btn-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-4);
    background: var(--color-primary);
    color: white;
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .btn-checkout:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 480px) {
    .cart-drawer {
      width: 100%;
    }
  }
</style>

<script>
  import { getCartState, updateCartItemQuantity, removeFromCart } from '../lib/cart';

  /**
   * El cart vive en PageLayout (se re-renderiza en cada view-transition).
   * - Los listeners globales (delegación) se bindean UNA sola vez con guardia.
   * - Las referencias a elementos se resuelven en cada uso (nunca quedan "viejas").
   */

  // Referencias frescas (siempre apuntan al drawer actual del DOM)
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const getEls = () => ({
    overlay: $('cart-overlay'),
    drawer: $('cart-drawer'),
    emptyState: $('cart-empty'),
    itemsContainer: $('cart-items'),
    footer: $('cart-footer'),
    subtotalEl: $('cart-subtotal'),
    totalEl: $('cart-total'),
  });

  function formatPrice(price: number): string {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
    }).format(price);
  }

  function renderCart(): void {
    const { emptyState, itemsContainer, footer, subtotalEl, totalEl } = getEls();
    if (!itemsContainer || !subtotalEl || !totalEl) return;

    const state = getCartState();

    if (state.items.length === 0) {
      if (emptyState) emptyState.hidden = false;
      itemsContainer.hidden = true;
      if (footer) footer.hidden = true;
      return;
    }

    if (emptyState) emptyState.hidden = true;
    itemsContainer.hidden = false;
    if (footer) footer.hidden = false;

    itemsContainer.innerHTML = state.items
      .map(
        (item) => `
        <article class="cart-item">
          <img
            src="${item.image || '/placeholder-product.svg'}"
            alt="${item.name}"
            class="cart-item-image"
            width="80"
            height="80"
          />
          <div class="cart-item-info">
            <a href="/product/${item.slug}" class="cart-item-name">${item.name}</a>
            <span class="cart-item-price">${formatPrice(item.price)}</span>
            <div class="cart-item-controls">
              <div class="qty-control">
                <button class="qty-btn qty-decrease" data-id="${item.product_id}" aria-label="Disminuir">−</button>
                <span class="cart-item-qty">${item.quantity}</span>
                <button class="qty-btn qty-increase" data-id="${item.product_id}" aria-label="Aumentar">+</button>
              </div>
              <button class="remove-btn" data-id="${item.product_id}" aria-label="Eliminar">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>
          </div>
        </article>
      `
      )
      .join('');

    subtotalEl.textContent = formatPrice(state.total);
    totalEl.textContent = formatPrice(state.total);

    itemsContainer.querySelectorAll('.qty-decrease').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        const item = getCartState().items.find((i) => i.product_id === id);
        if (item) {
          await updateCartItemQuantity(id, item.quantity - 1);
          renderCart();
          window.dispatchEvent(new Event('cart-updated'));
        }
      });
    });

    itemsContainer.querySelectorAll('.qty-increase').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        const item = getCartState().items.find((i) => i.product_id === id);
        if (item) {
          await updateCartItemQuantity(id, item.quantity + 1);
          renderCart();
          window.dispatchEvent(new Event('cart-updated'));
        }
      });
    });

    itemsContainer.querySelectorAll('.remove-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        await removeFromCart(id);
        renderCart();
        window.dispatchEvent(new Event('cart-updated'));
      });
    });
  }

  function openCart(): void {
    const { overlay, drawer } = getEls();
    if (overlay) overlay.hidden = false;
    if (drawer) drawer.classList.add('open');
    renderCart();
  }

  function closeCart(): void {
    const { overlay, drawer } = getEls();
    if (overlay) overlay.hidden = true;
    if (drawer) drawer.classList.remove('open');
  }

  // --- Listeners globales: UNA sola vez, sobreviven a view transitions ---
  if (!(window as any).__cartDrawerBound) {
    (window as any).__cartDrawerBound = true;

    // Delegación: click en cualquier [data-cart-open] actual o futuro
    document.addEventListener('click', (e) => {
      const opener = (e.target as HTMLElement).closest('[data-cart-open]');
      if (opener) {
        e.preventDefault();
        openCart();
        return;
      }

      const { overlay, drawer } = getEls();
      const onCloseBtn = (e.target as HTMLElement).closest('#cart-close');
      if (onCloseBtn || e.target === overlay) {
        closeCart();
      }
    });

    document.addEventListener('keydown', (e) => {
      const { drawer } = getEls();
      if (e.key === 'Escape' && drawer?.classList.contains('open')) {
        closeCart();
      }
    });

    window.addEventListener('open-cart', openCart);
    window.addEventListener('cart-updated', renderCart);

    // Re-render al llegar a una nueva página (view transitions)
    document.addEventListener('astro:page-load', renderCart);
  }

  renderCart();
</script>
