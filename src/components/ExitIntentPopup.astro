---
/**
 * ExitIntentPopup.astro
 * Popup de descuento al salir de la página (captura emails)
 * 
 * @see https://cxl.com/blog/exit-intent-popups/
 */
---

<div class="exit-popup-overlay" id="exit-popup" hidden>
  <div class="exit-popup">
    <button class="popup-close" id="popup-close" aria-label="Cerrar popup">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="popup-content">
      <div class="popup-icon">👹</div>
      <span class="popup-badge">¡ESPECIAL!</span>
      <h2 class="popup-title">¡Espera, guerrero!</h2>
      <p class="popup-text">El troll tiene un regalo para ti: <strong>10% de descuento</strong> en tu primera compra</p>
      
      <form class="popup-form" id="popup-form">
        <div class="input-group">
          <input 
            type="email" 
            id="popup-email"
            placeholder="Tu email guerrero"
            required
            class="popup-input"
          />
          <button type="submit" class="popup-btn">
            <span class="btn-text">Obtener descuento</span>
            <span class="btn-loading" hidden>...</span>
          </button>
        </div>
        <p class="popup-disclaimer">Sin spam. Solo ofertas legendarias de la cueva.</p>
      </form>

      <div class="popup-success" id="popup-success" hidden>
        <div class="success-icon">✅</div>
        <h3>¡Código enviado!</h3>
        <p>Tu código: <strong class="coupon-code">TROLL10</strong></p>
        <p class="success-hint">Cópialo y úsalo en el checkout</p>
      </div>

      <div class="popup-social-proof">
        <div class="proof-avatars">
          <span class="avatar">👤</span>
          <span class="avatar">👤</span>
          <span class="avatar">👤</span>
        </div>
        <span class="proof-text">+500 guerreros ya reclamaron su descuento</span>
      </div>
    </div>
  </div>
</div>

<style>
  .exit-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    animation: fadeIn 0.3s ease;
  }

  .exit-popup-overlay[hidden] {
    display: none;
  }

  .exit-popup {
    position: relative;
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-secondary) 100%);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-2xl);
    max-width: 440px;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(76, 175, 80, 0.25);
    animation: slideUp 0.4s ease;
  }

  .exit-popup::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  }

  .popup-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-tertiary);
    border: none;
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 1;
  }

  .popup-close:hover {
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .popup-content {
    padding: var(--space-8) var(--space-6) var(--space-6);
    text-align: center;
  }

  .popup-icon {
    font-size: 3rem;
    margin-bottom: var(--space-2);
    animation: bounce 0.6s ease;
  }

  .popup-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-3);
  }

  .popup-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .popup-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
    line-height: 1.6;
  }

  .popup-text strong {
    color: var(--color-primary);
    font-size: var(--text-base);
  }

  .popup-form {
    margin-bottom: var(--space-6);
  }

  .input-group {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .popup-input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    font-size: var(--text-sm);
    transition: all var(--transition-fast);
  }

  .popup-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .popup-btn {
    padding: var(--space-3) var(--space-5);
    background: linear-gradient(135deg, var(--color-primary) 0%, #388e3c 100%);
    color: white;
    border: none;
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .popup-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
  }

  .popup-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .popup-success {
    animation: fadeIn 0.3s ease;
  }

  .success-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-3);
  }

  .popup-success h3 {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .popup-success p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2);
  }

  .coupon-code {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-family: monospace;
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    border-radius: var(--radius-lg);
    letter-spacing: 0.1em;
    cursor: pointer;
  }

  .coupon-code:hover {
    background: var(--color-primary);
    color: white;
  }

  .success-hint {
    font-size: var(--text-xs) !important;
    color: var(--color-text-muted);
  }

  .popup-social-proof {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .proof-avatars {
    display: flex;
  }

  .avatar {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-tertiary);
    border: 2px solid var(--color-bg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    margin-left: -8px;
  }

  .avatar:first-child {
    margin-left: 0;
  }

  .proof-text {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { 
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to { 
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (max-width: 480px) {
    .input-group {
      flex-direction: column;
    }

    .popup-btn {
      width: 100%;
    }
  }
</style>

<script>
  // Exit intent detection
  let hasShownPopup = false;
  
  function showPopup() {
    if (hasShownPopup) return;
    
    // Check if user already subscribed
    if (localStorage.getItem('popupDismissed')) return;
    
    const popup = document.getElementById('exit-popup');
    if (popup) {
      popup.hidden = false;
      hasShownPopup = true;
      document.body.style.overflow = 'hidden';
    }
  }

  // Mouse leave detection (desktop)
  document.addEventListener('mouseleave', (e) => {
    if (e.clientY <= 0) {
      showPopup();
    }
  });

  // Mobile: show after 30 seconds
  let mobileTimer: ReturnType<typeof setTimeout>;
  if (window.innerWidth <= 768) {
    mobileTimer = setTimeout(() => {
      showPopup();
    }, 30000);
  }

  // Close popup
  document.getElementById('popup-close')?.addEventListener('click', () => {
    const popup = document.getElementById('exit-popup');
    if (popup) {
      popup.hidden = true;
      document.body.style.overflow = '';
      localStorage.setItem('popupDismissed', 'true');
    }
    clearTimeout(mobileTimer);
  });

  // Close on overlay click
  document.getElementById('exit-popup')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id === 'exit-popup') {
      const popup = document.getElementById('exit-popup');
      if (popup) {
        popup.hidden = true;
        document.body.style.overflow = '';
        localStorage.setItem('popupDismissed', 'true');
      }
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const popup = document.getElementById('exit-popup');
      if (popup && !popup.hidden) {
        popup.hidden = true;
        document.body.style.overflow = '';
        localStorage.setItem('popupDismissed', 'true');
      }
    }
  });

  // Form submission
  document.getElementById('popup-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const email = (document.getElementById('popup-email') as HTMLInputElement).value;
    const btn = (e.target as HTMLFormElement).querySelector('.popup-btn') as HTMLButtonElement;
    const btnText = btn.querySelector('.btn-text') as HTMLElement;
    const btnLoading = btn.querySelector('.btn-loading') as HTMLElement;
    
    btnText.hidden = true;
    btnLoading.hidden = false;
    btn.disabled = true;

    // Simulate API call (replace with real email service)
    await new Promise(resolve => setTimeout(resolve, 1500));

    // Show success
    document.getElementById('popup-form')?.setAttribute('hidden', '');
    document.getElementById('popup-success')?.removeAttribute('hidden');

    // Copy coupon on click
    document.querySelector('.coupon-code')?.addEventListener('click', () => {
      navigator.clipboard.writeText('TROLL10');
      const el = document.querySelector('.coupon-code') as HTMLElement;
      el.textContent = '¡Copiado!';
      setTimeout(() => { el.textContent = 'TROLL10'; }, 2000);
    });
  });
</script>
