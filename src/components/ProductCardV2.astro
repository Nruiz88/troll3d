---
/**
 * ProductCardV2.astro
 * Tarjeta de producto mejorada con más información y efectos premium
 * 
 * @see https://www.nngroup.com/articles/e-commerce-product-pages/
 */

import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  id: string;
  name: string;
  slug: string;
  price: number;
  comparePrice?: number | null;
  shortDescription?: string | null;
  description?: string | null;
  images?: string[];
  featured?: boolean;
  stock?: number;
  sku?: string;
  category?: string;
}

const {
  id,
  name,
  slug,
  price,
  comparePrice,
  shortDescription,
  description,
  images = [],
  featured = false,
  stock = 0,
  sku,
  category,
} = Astro.props;

const mainImage = images[0] || '/placeholder-product.svg';
const hasDiscount = comparePrice && comparePrice > price;
const discount = hasDiscount
  ? Math.round(((comparePrice! - price) / comparePrice!) * 100)
  : 0;

const formattedPrice = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
}).format(price);

const formattedComparePrice = hasDiscount
  ? new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
    }).format(comparePrice!)
  : null;

const savings = hasDiscount ? comparePrice! - price : 0;
const formattedSavings = savings > 0
  ? new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(savings)
  : null;

const isLowStock = stock > 0 && stock <= 5;
const isOutOfStock = stock === 0;
---

<article class:list={['product-card-v2', { featured, 'low-stock': isLowStock, 'out-of-stock': isOutOfStock }]}>
  <a href={`/product/${slug}`} class="product-link">
    <!-- Image Section -->
    <div class="product-image-section">
      <div class="image-wrapper">
        <Image 
          src={mainImage} 
          alt={name} 
          class="product-image"
          width={400}
          height={400}
          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw"
          loading="lazy"
        />
        
        <!-- Badges -->
        <div class="badges">
          {hasDiscount && (
            <span class="badge discount-badge">-{discount}%</span>
          )}
          {featured && (
            <span class="badge featured-badge">⭐ Top</span>
          )}
          {isLowStock && (
            <span class="badge stock-badge">¡Últimas!</span>
          )}
        </div>
        
        <!-- Quick View Overlay -->
        <div class="quick-view-overlay">
          <span class="quick-view-btn">
            <Icon name="eye" width="16" height="16" />
            Ver producto
          </span>
        </div>
      </div>
    </div>

    <!-- Info Section -->
    <div class="product-info">
      <!-- Category -->
      {category && (
        <span class="product-category">{category}</span>
      )}
      
      <!-- Title -->
      <h3 class="product-title">{name}</h3>
      
      <!-- Short Description -->
      {shortDescription && (
        <p class="product-desc">{shortDescription}</p>
      )}

      <!-- Price Section -->
      <div class="price-section">
        <div class="price-main">
          <span class="current-price">{formattedPrice}</span>
          {formattedComparePrice && (
            <span class="compare-price">{formattedComparePrice}</span>
          )}
          {formattedSavings && (
            <span class="savings-badge">-{discount}%</span>
          )}
        </div>
      </div>
    </div>
  </a>
  
  <!-- Add to Cart Button -->
  <div class="card-footer">
    <button 
      class="add-to-cart-btn"
      data-product-id={id}
      data-product-name={name}
      data-product-slug={slug}
      data-product-price={price}
      data-product-image={mainImage}
      disabled={isOutOfStock}
      aria-label={isOutOfStock ? 'Agotado' : `Agregar ${name} al carrito`}
    >
      {isOutOfStock ? (
        <span class="btn-text">Agotado</span>
      ) : (
        <>
          <Icon name="shopping-bag" width="18" height="18" />
          <span class="btn-text">Agregar al carrito</span>
        </>
      )}
    </button>
  </div>
</article>

<style>
  .product-card-v2 {
    position: relative;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  /* Brillo de borde al hover (efecto premium) */
  .product-card-v2::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.6), transparent 40%, transparent 60%, rgba(255, 87, 34, 0.4));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
    z-index: 3;
  }

  .product-card-v2:hover::before {
    opacity: 1;
  }

  .product-card-v2:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4), 0 0 24px rgba(76, 175, 80, 0.15);
    border-color: transparent;
  }

  .product-card-v2.out-of-stock {
    opacity: 0.7;
  }

  .product-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  /* Image Section — cuadrada, imagen completa visible */
  .product-image-section {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: radial-gradient(ellipse at center, var(--color-bg-secondary) 0%, color-mix(in srgb, var(--color-bg-secondary) 70%, #000) 100%);
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    padding: var(--space-5);
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.4));
    transition: transform var(--transition-slow), filter var(--transition-slow);
  }

  .product-card-v2:hover .product-image {
    transform: scale(1.06) translateY(-4px);
    filter: drop-shadow(0 20px 32px rgba(0, 0, 0, 0.5));
  }

  /* Badges */
  .badges {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    z-index: 2;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .discount-badge {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    color: white;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
  }

  .featured-badge {
    background: linear-gradient(135deg, var(--color-primary) 0%, #22c55e 100%);
    color: white;
    box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
  }

  .stock-badge {
    background: linear-gradient(135deg, var(--color-accent) 0%, #e64a19 100%);
    color: white;
    animation: pulse-badge 2s infinite;
  }

  @keyframes pulse-badge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  /* Quick View Overlay */
  .quick-view-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .product-card-v2:hover .quick-view-overlay {
    opacity: 1;
  }

  .quick-view-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: rgba(10, 15, 13, 0.85);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    transform: translateY(10px);
    transition: transform var(--transition-base), background var(--transition-base);
  }

  .product-card-v2:hover .quick-view-btn {
    background: rgba(76, 175, 80, 0.9);
  }

  .product-card-v2:hover .quick-view-btn {
    transform: translateY(0);
  }

  /* Info Section — textos centrados */
  .product-info {
    flex: 1;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  .product-category {
    display: inline-flex;
    padding: var(--space-1) var(--space-3);
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 10px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: var(--radius-full);
  }

  .product-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    line-height: 1.3;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    /* Altura fija de 2 líneas para que todas las cards queden parejas */
    min-height: calc(1.3em * 2);
    overflow: hidden;
  }

  .product-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    /* Altura fija de 2 líneas para igualar alturas entre cards */
    min-height: calc(1.5em * 2);
    overflow: hidden;
  }

  /* Price Section */
  .price-section {
    margin-top: auto;
  }

  .price-main {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .current-price {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .compare-price {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .savings-badge {
    display: inline-flex;
    align-self: center;
    padding: var(--space-1) var(--space-2);
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    font-size: 11px;
    font-weight: var(--font-bold);
    border-radius: var(--radius-md);
    letter-spacing: 0.02em;
  }

  /* Card Footer */
  .card-footer {
    padding: 0 var(--space-5) var(--space-5);
  }

  .add-to-cart-btn {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: linear-gradient(135deg, var(--color-primary) 0%, #388e3c 100%);
    color: white;
    border: none;
    border-radius: var(--radius-xl);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);
  }

  /* Brillo que barre el botón al hover */
  .add-to-cart-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -80%;
    width: 50%;
    height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    transform: skewX(-20deg);
    transition: none;
    pointer-events: none;
  }

  .add-to-cart-btn:hover:not(:disabled)::after {
    left: 130%;
    transition: left 0.55s ease;
  }

  .add-to-cart-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(76, 175, 80, 0.4);
  }

  .add-to-cart-btn:disabled {
    background: var(--color-border);
    color: var(--color-text-muted);
    cursor: not-allowed;
    box-shadow: none;
  }

  .add-to-cart-btn:active:not(:disabled) {
    transform: scale(0.98);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .product-info {
      padding: var(--space-4);
    }

    .product-title {
      font-size: var(--text-sm);
    }

    .current-price {
      font-size: var(--text-xl);
    }
  }
</style>

<script>
  import { addToCart } from '../lib/cart';

  document.querySelectorAll('.add-to-cart-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const target = e.currentTarget as HTMLButtonElement;
      const product = {
        id: target.dataset.productId!,
        name: target.dataset.productName!,
        slug: target.dataset.productSlug!,
        price: parseFloat(target.dataset.productPrice!),
        images: [target.dataset.productImage!],
      };

      // Button animation
      const btnText = target.querySelector('.btn-text');
      const originalText = btnText?.textContent || '';
      
      target.disabled = true;
      if (btnText) btnText.textContent = 'Agregando...';

      await addToCart(product);

      if (btnText) btnText.textContent = '✓ Agregado';
      target.style.background = '#22c55e';

      window.dispatchEvent(new Event('cart-updated'));
      window.dispatchEvent(new Event('open-cart'));

      setTimeout(() => {
        if (btnText) btnText.textContent = originalText;
        target.style.background = '';
        target.disabled = false;
      }, 2000);
    });
  });
</script>
