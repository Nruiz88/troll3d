---
/**
 * account/index.astro
 * Dashboard del cliente con perfil y pedidos recientes
 * 
 * @see https://supabase.com/docs/guides/auth
 */

import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Mi cuenta" description="Gestiona tu cuenta y revisa tus pedidos.">

  <div class="account-container">
    <!-- Sidebar -->
    <aside class="account-sidebar">
      <div class="user-card" id="user-card">
        <div class="user-avatar" id="user-avatar">👤</div>
        <div class="user-info">
          <h3 class="user-name" id="user-name">Cargando...</h3>
          <p class="user-email" id="user-email">-</p>
        </div>
      </div>

      <nav class="account-nav">
        <a href="/account" class="nav-link active">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Resumen
        </a>
        <a href="/account/orders" class="nav-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          Mis pedidos
        </a>
        <a href="/account/addresses" class="nav-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Direcciones
        </a>
        <a href="/account/profile" class="nav-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          Mi perfil
        </a>
      </nav>

      <button class="logout-btn" id="logout-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Cerrar sesión
      </button>
    </aside>

    <!-- Main Content -->
    <main class="account-main">
      <div class="welcome-section">
        <h1 class="welcome-title">Bienvenido, <span id="welcome-name">Guerrero</span> 👹</h1>
        <p class="welcome-subtitle">Aquí tienes un resumen de tu cuenta</p>
      </div>

      <!-- Stats Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon">🛒</div>
          <div class="stat-info">
            <span class="stat-value" id="total-orders">0</span>
            <span class="stat-label">Pedidos totales</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">📦</div>
          <div class="stat-info">
            <span class="stat-value" id="pending-orders">0</span>
            <span class="stat-label">En proceso</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">✅</div>
          <div class="stat-info">
            <span class="stat-value" id="completed-orders">0</span>
            <span class="stat-label">Completados</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">💰</div>
          <div class="stat-info">
            <span class="stat-value" id="total-spent">$0</span>
            <span class="stat-label">Total gastado</span>
          </div>
        </div>
      </div>

      <!-- Recent Orders -->
      <div class="section-card">
        <div class="section-header">
          <h2 class="section-title">Pedidos recientes</h2>
          <a href="/account/orders" class="see-all">Ver todos →</a>
        </div>
        
        <div class="orders-list" id="orders-list">
          <div class="empty-state" id="empty-orders">
            <div class="empty-icon">📦</div>
            <h3 class="empty-title">Sin pedidos aún</h3>
            <p class="empty-text">¡Es hora de explorar la cueva!</p>
            <a href="/shop" class="empty-btn">Ir a la tienda</a>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="section-card">
        <h2 class="section-title">Acciones rápidas</h2>
        <div class="actions-grid">
          <a href="/shop" class="action-card">
            <span class="action-icon">⚔️</span>
            <span class="action-label">Explorar tienda</span>
          </a>
          <a href="/account/orders" class="action-card">
            <span class="action-icon">📋</span>
            <span class="action-label">Ver pedidos</span>
          </a>
          <a href="/account/profile" class="action-card">
            <span class="action-icon">👤</span>
            <span class="action-label">Editar perfil</span>
          </a>
          <a href="/contact" class="action-card">
            <span class="action-icon">💬</span>
            <span class="action-label">Contacto</span>
          </a>
        </div>
      </div>
    </main>
  </div>

</PageLayout>

<style>
  .account-container {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-8);
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    min-height: 80vh;
  }

  /* Sidebar */
  .account-sidebar {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    height: fit-content;
    position: sticky;
    top: 100px;
  }

  .user-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .user-avatar {
    width: 60px;
    height: 60px;
    background: var(--color-primary-light);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
  }

  .user-name {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin: 0;
  }

  .user-email {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    word-break: break-all;
  }

  .account-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .nav-link.active {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .logout-btn {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .logout-btn:hover {
    background: var(--color-error-light);
    border-color: var(--color-error);
    color: var(--color-error);
  }

  /* Main Content */
  .account-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .welcome-section {
    margin-bottom: var(--space-4);
  }

  .welcome-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .welcome-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .stat-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    transition: all var(--transition-normal);
  }

  .stat-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .stat-icon {
    font-size: 1.75rem;
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Section Card */
  .section-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
  }

  .see-all {
    font-size: var(--text-sm);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
  }

  .see-all:hover {
    text-decoration: underline;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: var(--space-12) var(--space-6);
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: var(--space-4);
  }

  .empty-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .empty-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
  }

  .empty-btn {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--color-primary);
    color: white;
    text-decoration: none;
    border-radius: var(--radius-lg);
    font-weight: var(--font-medium);
    transition: all var(--transition-fast);
  }

  .empty-btn:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
  }

  /* Order Item */
  .order-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-3);
    transition: all var(--transition-fast);
  }

  .order-item:hover {
    background: var(--color-bg-hover);
  }

  .order-info {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .order-number {
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .order-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .order-status {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
  }

  .status-pending {
    background: var(--color-warning-light);
    color: var(--color-warning);
  }

  .status-processing {
    background: var(--color-info-light);
    color: var(--color-info);
  }

  .status-shipped {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .status-delivered {
    background: var(--color-success-light);
    color: var(--color-success);
  }

  .order-total {
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  /* Actions Grid */
  .actions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .action-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .action-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(76, 175, 80, 0.15);
  }

  .action-icon {
    font-size: 2rem;
  }

  .action-label {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text);
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .actions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .account-container {
      grid-template-columns: 1fr;
    }

    .account-sidebar {
      position: static;
    }

    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .actions-grid {
      grid-template-columns: 1fr 1fr;
    }

    .order-item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>

<script>
  let supabase: any = null;

  async function getSupabase() {
    if (!supabase) {
      const { createClient } = await import('@supabase/supabase-js');
      supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );
    }
    return supabase;
  }

  let currentUser: any = null;

  async function loadUserData() {
    const client = await getSupabase();
    const { data: { user } } = await client.auth.getUser();
    
    if (!user) {
      window.location.href = '/auth/login';
      return;
    }

    currentUser = user;

    // Update UI with user data
    const fullName = user.user_metadata?.full_name || 'Guerrero';
    const email = user.email || '-';
    const initials = fullName.split(' ').map((n: string) => n[0]).join('').toUpperCase().slice(0, 2);

    document.getElementById('user-name')!.textContent = fullName;
    document.getElementById('user-email')!.textContent = email;
    document.getElementById('welcome-name')!.textContent = fullName.split(' ')[0];
    document.getElementById('user-avatar')!.textContent = initials;

    // Load order stats
    await loadOrderStats(user.id);
    await loadRecentOrders(user.id);
  }

  async function loadOrderStats(userId: string) {
    const client = await getSupabase();
    const { data: orders } = await client
      .from('orders')
      .select('status, total')
      .eq('customer_id', userId);

    if (orders) {
      const total = orders.length;
      const pending = orders.filter((o: any) => ['pending', 'processing'].includes(o.status)).length;
      const completed = orders.filter((o: any) => o.status === 'delivered').length;
      const spent = orders.reduce((sum: number, o: any) => sum + (o.total || 0), 0);

      document.getElementById('total-orders')!.textContent = total.toString();
      document.getElementById('pending-orders')!.textContent = pending.toString();
      document.getElementById('completed-orders')!.textContent = completed.toString();
      document.getElementById('total-spent')!.textContent = `$${spent.toLocaleString()}`;
    }
  }

  async function loadRecentOrders(userId: string) {
    const client = await getSupabase();
    const { data: orders } = await client
      .from('orders')
      .select('*')
      .eq('customer_id', userId)
      .order('created_at', { ascending: false })
      .limit(5);

    const ordersList = document.getElementById('orders-list');
    const emptyState = document.getElementById('empty-orders');

    if (orders && orders.length > 0) {
      if (emptyState) emptyState.hidden = true;

      orders.forEach((order: any) => {
        const orderEl = document.createElement('div');
        orderEl.className = 'order-item';
        orderEl.innerHTML = `
          <div class="order-info">
            <span class="order-number">#${order.id.slice(0, 8).toUpperCase()}</span>
            <span class="order-date">${new Date(order.created_at).toLocaleDateString('es-MX')}</span>
          </div>
          <span class="order-status status-${order.status}">${getStatusText(order.status)}</span>
          <span class="order-total">$${order.total.toLocaleString()}</span>
        `;
        orderEl.addEventListener('click', () => {
          window.location.href = `/account/orders/${order.id}`;
        });
        if (ordersList) ordersList.appendChild(orderEl);
      });
    } else {
      if (emptyState) emptyState.hidden = false;
    }
  }

  function getStatusText(status: string): string {
    const statuses: Record<string, string> = {
      pending: 'Pendiente',
      processing: 'Procesando',
      shipped: 'Enviado',
      delivered: 'Entregado',
      cancelled: 'Cancelado'
    };
    return statuses[status] || status;
  }

  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    const client = await getSupabase();
    await client.auth.signOut();
    window.location.href = '/';
  });

  // Init
  loadUserData();
</script>
