---
/**
 * admin/settings/payments.astro
 * Configuración de MercadoPago - Guarda credenciales en Supabase
 */

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Configuración de Pagos">
  
  <div class="settings-container">
    <!-- Header -->
    <div class="page-header">
      <div>
        <h1 class="page-title">💰 Configuración de Pagos</h1>
        <p class="page-subtitle">Configura las credenciales de MercadoPago para aceptar pagos</p>
      </div>
      <div class="header-actions">
        <a href="/admin/settings" class="btn-secondary">← Volver</a>
      </div>
    </div>

    <!-- Connection Status -->
    <div class="status-card" id="connection-status">
      <div class="status-indicator" id="status-dot"></div>
      <div class="status-info">
        <span class="status-text" id="status-text">Verificando conexión...</span>
        <span class="status-detail" id="status-detail"></span>
      </div>
      <button class="btn-test" id="btn-test-connection">Probar conexión</button>
    </div>

    <!-- Settings Form -->
    <form class="settings-form" id="settings-form">
      
      <!-- MercadoPago Credentials -->
      <div class="settings-section">
        <div class="section-header">
          <h2 class="section-title">
            <span class="section-icon">🔑</span>
            Credenciales de MercadoPago
          </h2>
          <div class="mode-toggle">
            <label class="toggle-label">
              <input type="checkbox" id="test-mode" name="test_mode" checked />
              <span class="toggle-slider"></span>
              <span class="toggle-text">Modo prueba</span>
            </label>
          </div>
        </div>
        
        <p class="section-desc">
          Obtén tus credenciales en <a href="https://www.mercadopago.com.ar/developers/panel/app" target="_blank">MercadoPago Developers</a>
        </p>

        <div class="credentials-grid">
          <div class="credential-card" id="access-token-card">
            <div class="credential-header">
              <span class="credential-label">Access Token</span>
              <span class="credential-badge test">PRUEBA</span>
            </div>
            <input 
              type="password" 
              id="access_token" 
              name="access_token"
              class="credential-input"
              placeholder="TEST-xxxx-xxxx-xxxx-..."
              autocomplete="off"
            />
            <button type="button" class="toggle-visibility" data-target="access_token" aria-label="Mostrar Access Token">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
            <span class="credential-help">Empieza con APP_USR- (producción) o TEST- (pruebas)</span>
          </div>

          <div class="credential-card" id="public-key-card">
            <div class="credential-header">
              <span class="credential-label">Public Key</span>
              <span class="credential-badge test">PRUEBA</span>
            </div>
            <input 
              type="text" 
              id="public_key" 
              name="public_key"
              class="credential-input"
              placeholder="TEST-xxxx-xxxx-xxxx-..."
              autocomplete="off"
            />
            <span class="credential-help">Se usa en el frontend para el checkout</span>
          </div>
        </div>
      </div>

      <!-- Webhook Configuration -->
      <div class="settings-section">
        <div class="section-header">
          <h2 class="section-title">
            <span class="section-icon">🔔</span>
            Webhook
          </h2>
        </div>

        <div class="webhook-info">
          <div class="webhook-field">
            <label class="field-label">URL del Webhook</label>
            <div class="webhook-url">
              <code id="webhook-url">{Astro.url.origin}/api/mercadopago/webhook</code>
              <button type="button" class="btn-copy" data-copy="webhook-url">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                Copiar
              </button>
            </div>
            <span class="field-help">Copia esta URL en tu panel de MercadoPago → Webhooks</span>
          </div>

          <div class="webhook-events">
            <h3 class="events-title">Eventos configurados:</h3>
            <div class="events-list">
              <span class="event-tag">✅ payment.created</span>
              <span class="event-tag">✅ payment.updated</span>
              <span class="event-tag">✅ payment.deleted</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Settings -->
      <div class="settings-section">
        <div class="section-header">
          <h2 class="section-title">
            <span class="section-icon">⚙️</span>
            Configuración de Pagos
          </h2>
        </div>

        <div class="settings-grid">
          <div class="setting-item">
            <label class="setting-label" for="currency">Moneda</label>
            <select id="currency" name="currency" class="setting-input">
              <option value="MXN" selected>Peso Mexicano (MXN)</option>
              <option value="ARS">Peso Argentino (ARS)</option>
              <option value="COP">Peso Colombiano (COP)</option>
              <option value="CLP">Peso Chileno (CLP)</option>
              <option value="BRL">Real Brasileño (BRL)</option>
              <option value="USD">Dólar Americano (USD)</option>
            </select>
          </div>

          <div class="setting-item">
            <label class="setting-label">Aceptor pagos con</label>
            <div class="payment-methods-check">
              <label class="checkbox-item">
                <input type="checkbox" name="accept_credit_card" checked />
                <span>Tarjeta de crédito</span>
              </label>
              <label class="checkbox-item">
                <input type="checkbox" name="accept_debit_card" checked />
                <span>Tarjeta de débito</span>
              </label>
              <label class="checkbox-item">
                <input type="checkbox" name="accept_cash" checked />
                <span>Efectivo (OXXO, etc.)</span>
              </label>
              <label class="checkbox-item">
                <input type="checkbox" name="accept_bank_transfer" checked />
                <span>Transferencia bancaria</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Save Button -->
      <div class="settings-actions">
        <button type="submit" class="btn-save" id="btn-save">
          <span class="btn-text">Guardar configuración</span>
          <span class="btn-loading" hidden>Guardando...</span>
        </button>
        <span class="save-status" id="save-status"></span>
      </div>
    </form>

    <!-- Info Card -->
    <div class="info-card">
      <h3 class="info-title">📖 ¿Cómo configurar MercadoPago?</h3>
      <ol class="info-steps">
        <li>Crea una cuenta en <a href="https://www.mercadopago.com" target="_blank">MercadoPago</a></li>
        <li>Ve a <a href="https://www.mercadopago.com.ar/developers/panel/app" target="_blank">Desarrolladores → Tu app</a></li>
        <li>Copia las credenciales (Access Token y Public Key)</li>
        <li>Pégalas aquí en modo <strong>prueba</strong> para testear</li>
        <li>Cuando estés listo, cambia a modo <strong>producción</strong></li>
        <li>Configura el webhook con la URL que aparece arriba</li>
      </ol>
    </div>
  </div>

</AdminLayout>

<style>
  .settings-container {
    max-width: 900px;
  }

  /* Status Card */
  .status-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-6);
  }

  .status-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-text-muted);
  }

  .status-indicator.connected {
    background: #22c55e;
    box-shadow: 0 0 12px rgba(34, 197, 94, 0.5);
  }

  .status-indicator.disconnected {
    background: #ef4444;
  }

  .status-info {
    flex: 1;
  }

  .status-text {
    display: block;
    font-weight: var(--font-medium);
    color: var(--color-text);
  }

  .status-detail {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .btn-test {
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-test:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Settings Form */
  .settings-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .settings-section {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
  }

  .section-icon {
    font-size: 1.25rem;
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
  }

  .section-desc a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .section-desc a:hover {
    text-decoration: underline;
  }

  /* Mode Toggle */
  .mode-toggle {
    display: flex;
    align-items: center;
  }

  .toggle-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
  }

  .toggle-label input {
    display: none;
  }

  .toggle-slider {
    width: 48px;
    height: 26px;
    background: var(--color-border);
    border-radius: 13px;
    position: relative;
    transition: all var(--transition-fast);
  }

  .toggle-slider::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    background: white;
    border-radius: 50%;
    transition: transform var(--transition-fast);
  }

  .toggle-label input:checked + .toggle-slider {
    background: var(--color-primary);
  }

  .toggle-label input:checked + .toggle-slider::after {
    transform: translateX(22px);
  }

  .toggle-text {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text);
  }

  /* Credentials Grid */
  .credentials-grid {
    display: grid;
    gap: var(--space-4);
  }

  .credential-card {
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .credential-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .credential-label {
    font-weight: var(--font-medium);
    color: var(--color-text);
  }

  .credential-badge {
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-md);
  }

  .credential-badge.test {
    background: var(--color-warning-light);
    color: var(--color-warning);
  }

  .credential-badge.production {
    background: var(--color-success-light);
    color: var(--color-success);
  }

  .credential-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    font-family: monospace;
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .credential-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .toggle-visibility {
    position: absolute;
    right: var(--space-3);
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-2);
  }

  .toggle-visibility:hover {
    color: var(--color-text);
  }

  .credential-help {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Webhook */
  .webhook-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .webhook-url {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-2);
  }

  .webhook-url code {
    flex: 1;
    font-family: monospace;
    font-size: var(--text-sm);
    color: var(--color-primary);
    word-break: break-all;
  }

  .btn-copy {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-copy:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .field-label {
    display: block;
    font-weight: var(--font-medium);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .field-help {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .events-title {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  .events-list {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .event-tag {
    padding: var(--space-1) var(--space-3);
    background: var(--color-success-light);
    color: var(--color-success);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    border-radius: var(--radius-full);
  }

  /* Settings Grid */
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }

  .setting-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .setting-label {
    font-weight: var(--font-medium);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .setting-input {
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .setting-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .payment-methods-check {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .checkbox-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .checkbox-item input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-primary);
  }

  /* Actions */
  .settings-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .btn-save {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-hover) 100%);
    color: white;
    border: none;
    border-radius: var(--radius-lg);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .btn-save:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(76, 175, 80, 0.3);
  }

  .btn-save:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .save-status {
    font-size: var(--text-sm);
    color: var(--color-success);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .save-status.visible {
    opacity: 1;
  }

  /* Info Card */
  .info-card {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .info-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }

  .info-steps {
    margin: 0;
    padding-left: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 2;
  }

  .info-steps a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .info-steps a:hover {
    text-decoration: underline;
  }
</style>

<script>
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  let supabase: any;

  async function initSupabase() {
    const { createClient } = await import('@supabase/supabase-js');
    supabase = createClient(supabaseUrl, supabaseKey);
    
    // Check auth
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) {
      window.location.href = '/admin/login';
      return;
    }
    
    await loadSettings();
  }

  async function loadSettings() {
    const { data: settings } = await supabase
      .from('settings')
      .select('*')
      .in('category', ['payments', 'general']);

    if (settings) {
      settings.forEach((setting: any) => {
        const input = document.querySelector(`[name="${setting.key}"], #${setting.key.replace(/_/g, '-')}`) as HTMLInputElement;
        if (input) {
          const value = typeof setting.value === 'string' 
            ? JSON.parse(setting.value) 
            : setting.value;
          
          if (input.type === 'checkbox') {
            input.checked = value === true || value === 'true';
          } else {
            input.value = value || '';
          }
        }
      });

      // Update mode toggle
      const testMode = settings.find((s: any) => s.key === 'mercadopago_test_mode');
      if (testMode) {
        const value = typeof testMode.value === 'string' ? JSON.parse(testMode.value) : testMode.value;
        updateModeUI(value === true || value === 'true');
      }
    }
  }

  function updateModeUI(isTestMode: boolean) {
    const badges = document.querySelectorAll('.credential-badge');
    badges.forEach(badge => {
      if (isTestMode) {
        badge.textContent = 'PRUEBA';
        badge.className = 'credential-badge test';
      } else {
        badge.textContent = 'PRODUCCIÓN';
        badge.className = 'credential-badge production';
      }
    });
  }

  // Toggle visibility
  document.querySelectorAll('.toggle-visibility').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLElement).dataset.target;
      if (!target) return;
      const input = document.getElementById(target) as HTMLInputElement | null;
      if (input) input.type = input.type === 'password' ? 'text' : 'password';
    });
  });

  // Mode toggle
  document.getElementById('test-mode')?.addEventListener('change', (e) => {
    updateModeUI((e.target as HTMLInputElement).checked);
  });

  // Copy webhook URL
  document.querySelectorAll('.btn-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const target = (btn as HTMLElement).dataset.copy;
      if (!target) return;
      const text = document.getElementById(target)?.textContent || '';
      await navigator.clipboard.writeText(text);
      btn.innerHTML = '✓ Copiado';
      setTimeout(() => {
        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> Copiar`;
      }, 2000);
    });
  });

  // Save settings
  document.getElementById('settings-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const btn = document.getElementById('btn-save') as HTMLButtonElement | null;
    const status = document.getElementById('save-status');
    
    if (!btn) return;
    btn.disabled = true;
    const btnTextEl = btn.querySelector('.btn-text') as HTMLElement | null;
    const btnLoadingEl = btn.querySelector('.btn-loading') as HTMLElement | null;
    if (btnTextEl) btnTextEl.hidden = true;
    if (btnLoadingEl) btnLoadingEl.hidden = false;

    const formData = new FormData(e.target as HTMLFormElement);
    
    const settingsToSave = [
      { key: 'mercadopago_access_token', value: JSON.stringify(formData.get('access_token') || ''), category: 'payments', description: 'Access Token de MercadoPago' },
      { key: 'mercadopago_public_key', value: JSON.stringify(formData.get('public_key') || ''), category: 'payments', description: 'Public Key de MercadoPago' },
      { key: 'mercadopago_test_mode', value: JSON.stringify(formData.get('test_mode') === 'on'), category: 'payments', description: 'Modo de prueba' },
      { key: 'payment_currency', value: JSON.stringify(formData.get('currency') || 'MXN'), category: 'payments', description: 'Moneda de pago' },
    ];

    try {
      for (const setting of settingsToSave) {
        await supabase
          .from('settings')
          .upsert(setting, { onConflict: 'key' });
      }

      if (status) {
        status.textContent = '✓ Configuración guardada';
        status.classList.add('visible');
        setTimeout(() => status.classList.remove('visible'), 3000);
      }
    } catch (err) {
      if (status) {
        status.textContent = '✗ Error al guardar';
        status.style.color = 'var(--color-error)';
      }
    }

    btn.disabled = false;
    const btnTextEl2 = btn.querySelector('.btn-text') as HTMLElement | null;
    const btnLoadingEl2 = btn.querySelector('.btn-loading') as HTMLElement | null;
    if (btnTextEl2) btnTextEl2.hidden = false;
    if (btnLoadingEl2) btnLoadingEl2.hidden = true;
  });

  // Test connection
  document.getElementById('btn-test-connection')?.addEventListener('click', async () => {
    const dot = document.getElementById('status-dot');
    const text = document.getElementById('status-text');
    const detail = document.getElementById('status-detail');
    
    if (dot) dot.className = 'status-indicator';
    if (text) text.textContent = 'Probando conexión...';
    if (detail) detail.textContent = '';

    const accessToken = (document.getElementById('access_token') as HTMLInputElement | null)?.value || '';
    
    if (!accessToken) {
      if (dot) dot.classList.add('disconnected');
      if (text) text.textContent = 'No configurado';
      if (detail) detail.textContent = 'Ingresa tu Access Token';
      return;
    }

    try {
      const response = await fetch('https://api.mercadopago.com/v1/payment_methods', {
        headers: {
          'Authorization': `Bearer ${accessToken}`
        }
      });

      if (response.ok) {
        if (dot) dot.classList.add('connected');
        if (text) text.textContent = '✓ Conexión exitosa';
        if (detail) detail.textContent = 'MercadoPago está configurado correctamente';
      } else {
        if (dot) dot.classList.add('disconnected');
        if (text) text.textContent = '✗ Error de conexión';
        if (detail) detail.textContent = 'Verifica tus credenciales';
      }
    } catch (err) {
      if (dot) dot.classList.add('disconnected');
      if (text) text.textContent = '✗ Error de red';
      if (detail) detail.textContent = 'No se pudo conectar con MercadoPago';
    }
  });

  initSupabase();
</script>
