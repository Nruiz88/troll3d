---
/**
 * orders/index.astro
 * Gestión de pedidos en el panel de administración.
 *
 * @see https://docs.astro.build/en/basics/pages/
 */

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabase } from '../../../lib/supabase';

// Obtener pedidos con información del cliente
const { data: ordersRaw, error } = await supabase
  .from('orders')
  .select(`
    id,
    status,
    subtotal,
    tax,
    shipping,
    total,
    currency,
    notes,
    created_at,
    updated_at,
    customers:customer_id (
      full_name,
      email,
      phone
    )
  `)
  .order('created_at', { ascending: false });

const orders = ordersRaw || [];

if (error) {
  console.error('Error fetching orders:', error);
}

const statusLabels: Record<string, string> = {
  pending: 'Pendiente',
  processing: 'Procesando',
  shipped: 'Enviado',
  delivered: 'Entregado',
  cancelled: 'Cancelado',
};

function formatPrice(price: number): string {
  return new Intl.NumberFormat('es-MX', {
    style: 'currency',
    currency: 'MXN',
  }).format(price);
}
---

<AdminLayout title="Pedidos">
  <div class="page">
    <div class="page-header">
      <div>
        <h2 class="page-title">📋 Gestión de pedidos</h2>
        <p class="page-subtitle">Total: <strong>{orders?.length || 0}</strong> pedidos • Pendientes: <strong>{orders?.filter(o => o.status === 'pending').length || 0}</strong></p>
      </div>
    </div>

    {error && (
      <div class="alert alert-error">
        <span>❌ Error al cargar los pedidos.</span>
      </div>
    )}

    {!error && orders && orders.length === 0 && (
      <div class="card">
        <div class="card-body text-center">
          <div class="empty-state">
            <div class="empty-icon">📦</div>
            <h3>No hay pedidos aún</h3>
            <p>Los pedidos aparecerán cuando los clientes realicen compras en tu tienda.</p>
          </div>
        </div>
      </div>
    )}

    {orders && orders.length > 0 && (
      <div class="card">
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Pedido</th>
                <th>Cliente</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {orders.map((order) => (
                <tr>
                  <td>
                    <span class="order-number">#{order.id.slice(0, 8).toUpperCase()}</span>
                  </td>
                  <td>
                    <div class="customer-cell">
                      <div>
                        <div class="customer-name">{order.customers?.[0]?.full_name || 'Sin nombre'}</div>
                        <div class="customer-email">{order.customers?.[0]?.email}</div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="price-value">{formatPrice(order.total || 0)}</span>
                  </td>
                  <td>
                    <span class:list={['status-badge', `status-${order.status}`]}>
                      {statusLabels[order.status] || order.status}
                    </span>
                  </td>
                  <td>
                    <span class="date-value">
                      {new Date(order.created_at).toLocaleDateString('es-ES', {
                        day: 'numeric',
                        month: 'short',
                        year: '2-digit',
                      })}
                    </span>
                  </td>
                  <td>
                    <a href={`/admin/orders/${order.id}`} class="btn btn-small btn-secondary">
                      Ver →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</AdminLayout>


