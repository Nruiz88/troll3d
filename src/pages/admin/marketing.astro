---
/**
 * admin/marketing.astro
 * Panel de administración para configurar elementos de conversión
 * 
 * @see https://docs.astro.build/en/basics/pages/
 */

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

// Obtener todas las configuraciones de marketing
const { data: settings } = await supabase
  .from('marketing_settings')
  .select('*')
  .order('category', { ascending: true });

// Agrupar por categoría
const categories: Record<string, any[]> = {};
settings?.forEach(s => {
  if (!categories[s.category]) categories[s.category] = [];
  categories[s.category].push(s);
});
---

<AdminLayout title="Marketing & Conversión">
  <div class="marketing-page">
    <header class="page-header">
      <div>
        <h2 class="page-title">📈 Marketing & Conversión</h2>
        <p class="page-subtitle">Configura los elementos que aumentan tus ventas</p>
      </div>
    </header>

    <!-- Countdown Timer -->
    <section class="config-card">
      <div class="card-header">
        <div class="card-title-row">
          <h3 class="card-title">⏰ Countdown Timer</h3>
          <label class="toggle-switch">
            <input type="checkbox" id="countdown-enabled" data-key="countdown_enabled" 
              checked={categories.countdown?.find((s: any) => s.key === 'countdown_enabled')?.value === 'true'} />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <p class="card-desc">Muestra urgencia con una cuenta regresiva de ofertas</p>
      </div>
      <div class="card-body">
        <div class="form-grid">
          <div class="form-group">
            <label for="countdown-label">Texto del countdown</label>
            <input type="text" id="countdown-label" data-key="countdown_label"
              value={categories.countdown?.find((s: any) => s.key === 'countdown_label')?.value?.replace(/"/g, '') || '¡Oferta especial termina en!'} />
          </div>
          <div class="form-group">
            <label for="countdown-date">Fecha de fin</label>
            <input type="datetime-local" id="countdown-date" data-key="countdown_end_date"
              value={categories.countdown?.find((s: any) => s.key === 'countdown_end_date')?.value?.replace(/"/g, '').slice(0, 16) || ''} />
          </div>
        </div>
        <div class="preview-box">
          <span class="preview-label">Vista previa:</span>
          <div class="preview-countdown">
            <span class="preview-text" id="preview-countdown-text">¡Oferta especial termina en!</span>
            <div class="preview-timer">
              <span>02</span>:<span>15</span>:<span>30</span>:<span>45</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Exit Intent Popup -->
    <section class="config-card">
      <div class="card-header">
        <div class="card-title-row">
          <h3 class="card-title">🎯 Popup de Descuento</h3>
          <label class="toggle-switch">
            <input type="checkbox" id="popup-enabled" data-key="popup_enabled"
              checked={categories.popup?.find((s: any) => s.key === 'popup_enabled')?.value === 'true'} />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <p class="card-desc">Captura emails ofreciendo descuento al salir de la página</p>
      </div>
      <div class="card-body">
        <div class="form-grid">
          <div class="form-group">
            <label for="popup-title">Título del popup</label>
            <input type="text" id="popup-title" data-key="popup_title"
              value={categories.popup?.find((s: any) => s.key === 'popup_title')?.value?.replace(/"/g, '') || '¡Espera, guerrero!'} />
          </div>
          <div class="form-group">
            <label for="popup-coupon">Código de cupón</label>
            <input type="text" id="popup-coupon" data-key="popup_coupon_code"
              value={categories.popup?.find((s: any) => s.key === 'popup_coupon_code')?.value?.replace(/"/g, '') || 'TROLL10'} />
          </div>
          <div class="form-group">
            <label for="popup-discount">Valor del descuento (%)</label>
            <input type="number" id="popup-discount" data-key="popup_discount_value" min="1" max="100"
              value={categories.popup?.find((s: any) => s.key === 'popup_discount_value')?.value?.replace(/"/g, '') || '10'} />
          </div>
          <div class="form-group full-width">
            <label for="popup-message">Mensaje</label>
            <textarea id="popup-message" data-key="popup_message" rows="2"
            >{categories.popup?.find((s: any) => s.key === 'popup_message')?.value?.replace(/"/g, '') || 'El troll tiene un regalo para ti: 10% de descuento en tu primera compra'}</textarea>
          </div>
        </div>
        <div class="preview-box">
          <span class="preview-label">Vista previa:</span>
          <div class="preview-popup">
            <div class="preview-popup-header">👹 ¡ESPECIAL!</div>
            <h4 id="preview-popup-title">¡Espera, guerrero!</h4>
            <p id="preview-popup-message">El troll tiene un regalo para ti: <strong><span id="preview-popup-discount">10</span>% de descuento</strong></p>
            <div class="preview-coupon">Cupón: <strong id="preview-popup-coupon">TROLL10</strong></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Proof -->
    <section class="config-card">
      <div class="card-header">
        <div class="card-title-row">
          <h3 class="card-title">👥 Prueba Social</h3>
          <label class="toggle-switch">
            <input type="checkbox" id="social-proof-enabled" data-category="social-links" data-key="social_proof_enabled"
              checked={categories['social-proof']?.find((s: any) => s.key === 'social_proof_enabled')?.value === 'true'} />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <p class="card-desc">Muestra confianza con visitantes en vivo, compras recientes y badges</p>
      </div>
      <div class="card-body">
        <div class="form-grid">
          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="social-visitors" data-category="social-links" data-key="social_proof_show_visitors"
                checked={categories['social-proof']?.find((s: any) => s.key === 'social_proof_show_visitors')?.value === 'true'} />
              <span>Mostrar visitantes en vivo</span>
            </label>
          </div>
          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="social-purchases" data-category="social-links" data-key="social_proof_show_purchases"
                checked={categories['social-proof']?.find((s: any) => s.key === 'social_proof_show_purchases')?.value === 'true'} />
              <span>Mostrar compras recientes</span>
            </label>
          </div>
          <div class="form-group full-width">
            <label for="social-trust">Texto de confianza</label>
            <input type="text" id="social-trust" data-category="social-links" data-key="social_proof_trust_text"
              value={categories['social-proof']?.find((s: any) => s.key === 'social_proof_trust_text')?.value?.replace(/"/g, '') || '4.9/5 en reseñas'} />
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky CTA -->
    <section class="config-card">
      <div class="card-header">
        <div class="card-title-row">
          <h3 class="card-title">📱 CTA Fijo (Mobile)</h3>
          <label class="toggle-switch">
            <input type="checkbox" id="sticky-cta-enabled" data-key="sticky_cta_enabled"
              checked={categories['sticky-cta']?.find((s: any) => s.key === 'sticky_cta_enabled')?.value === 'true'} />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <p class="card-desc">Botón fijo en mobile que aumenta conversiones hasta un 15%</p>
      </div>
      <div class="card-body">
        <div class="form-grid">
          <div class="form-group">
            <label for="cta-text">Texto del botón</label>
            <input type="text" id="cta-text" data-key="sticky_cta_text"
              value={categories['sticky-cta']?.find((s: any) => s.key === 'sticky_cta_text')?.value?.replace(/"/g, '') || '⚔️ Explorar la cueva'} />
          </div>
          <div class="form-group">
            <label for="cta-link">Enlace</label>
            <input type="text" id="cta-link" data-key="sticky_cta_link"
              value={categories['sticky-cta']?.find((s: any) => s.key === 'sticky_cta_link')?.value?.replace(/"/g, '') || '/shop'} />
          </div>
          <div class="form-group">
            <label for="cta-threshold">Mostrar después de (px)</label>
            <input type="number" id="cta-threshold" data-key="sticky_cta_threshold" min="0" max="1000"
              value={categories['sticky-cta']?.find((s: any) => s.key === 'sticky_cta_threshold')?.value?.replace(/"/g, '') || '300'} />
          </div>
        </div>
        <div class="preview-box">
          <span class="preview-label">Vista previa:</span>
          <div class="preview-cta">
            <span id="preview-cta-text">⚔️ Explorar la cueva</span>
            <span>→</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Redes Sociales -->
    <section class="config-card">
      <div class="card-header">
        <div class="card-title-row">
          <h3 class="card-title">🔗 Redes Sociales</h3>
        </div>
        <p class="card-desc">Links de tus redes sociales que se muestran en el sitio</p>
      </div>
      <div class="card-body">
        <div class="form-grid">
          <div class="form-group">
            <label for="social-facebook">📘 Facebook</label>
            <input type="url" id="social-facebook" data-category="social-links" data-key="social_facebook" placeholder="https://facebook.com/tupagina"
              value={categories['social-links']?.find((s: any) => s.key === 'social_facebook')?.value?.replace(/"/g, '') || ''} />
          </div>
          <div class="form-group">
            <label for="social-instagram">📸 Instagram</label>
            <input type="url" id="social-instagram" data-category="social-links" data-key="social_instagram" placeholder="https://instagram.com/tuusuario"
              value={categories['social-links']?.find((s: any) => s.key === 'social_instagram')?.value?.replace(/"/g, '') || ''} />
          </div>
          <div class="form-group">
            <label for="social-tiktok">🎵 TikTok</label>
            <input type="url" id="social-tiktok" data-category="social-links" data-key="social_tiktok" placeholder="https://tiktok.com/@tuusuario"
              value={categories['social-links']?.find((s: any) => s.key === 'social_tiktok')?.value?.replace(/"/g, '') || ''} />
          </div>
          <div class="form-group">
            <label for="social-whatsapp">💬 WhatsApp</label>
            <input type="url" id="social-whatsapp" data-category="social-links" data-key="social_whatsapp" placeholder="https://wa.me/5491112345678"
              value={categories['social-links']?.find((s: any) => s.key === 'social_whatsapp')?.value?.replace(/"/g, '') || ''} />
          </div>
        </div>
      </div>
    </section>

    <!-- Save Button -->
    <div class="save-section">
      <button class="btn-save" id="save-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        <span class="btn-text">Guardar cambios</span>
        <span class="btn-loading" hidden>Guardando...</span>
      </button>
      <span class="save-status" id="save-status"></span>
    </div>
  </div>
</AdminLayout>

<style>
  .marketing-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 900px;
  }

  /* Config Cards */
  .config-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .card-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Toggle Switch */
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 26px;
    cursor: pointer;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    inset: 0;
    background: var(--color-border);
    border-radius: 13px;
    transition: all var(--transition-fast);
  }

  .toggle-slider::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    background: white;
    border-radius: 50%;
    transition: transform var(--transition-fast);
  }

  .toggle-switch input:checked + .toggle-slider {
    background: var(--color-primary);
  }

  .toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(22px);
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .checkbox-label input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-primary);
  }

  /* Preview */
  .preview-box {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .preview-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .preview-countdown {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: linear-gradient(135deg, var(--color-accent) 0%, #e64a19 100%);
    border-radius: var(--radius-lg);
    color: white;
  }

  .preview-text {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .preview-timer {
    display: flex;
    gap: var(--space-2);
    font-family: monospace;
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
  }

  .preview-timer span {
    padding: var(--space-1) var(--space-2);
    background: rgba(0, 0, 0, 0.3);
    border-radius: var(--radius-md);
  }

  .preview-popup {
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .preview-popup-header {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .preview-popup h4 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .preview-popup p {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .preview-popup p strong {
    color: var(--color-primary);
  }

  .preview-coupon {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-family: monospace;
    font-weight: var(--font-bold);
    border-radius: var(--radius-md);
  }

  .preview-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: linear-gradient(135deg, var(--color-primary) 0%, #388e3c 100%);
    border-radius: var(--radius-lg);
    color: white;
    font-weight: var(--font-bold);
  }

  /* Save Section */
  .save-section {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .btn-save {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: linear-gradient(135deg, var(--color-primary) 0%, #388e3c 100%);
    color: white;
    border: none;
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);
  }

  .btn-save:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
  }

  .btn-save:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .save-status {
    font-size: var(--text-sm);
    color: var(--color-success);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .save-status.visible {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Live preview updates
  document.getElementById('countdown-label')?.addEventListener('input', (e) => {
    const el = document.getElementById('preview-countdown-text');
    if (el) el.textContent = (e.target as HTMLInputElement).value;
  });

  document.getElementById('popup-title')?.addEventListener('input', (e) => {
    const el = document.getElementById('preview-popup-title');
    if (el) el.textContent = (e.target as HTMLInputElement).value;
  });

  document.getElementById('popup-message')?.addEventListener('input', (e) => {
    const el = document.getElementById('preview-popup-message');
    if (el) el.innerHTML = (e.target as HTMLInputElement).value.replace('10%', '<strong><span id="preview-popup-discount">10</span>% de descuento</strong>');
  });

  document.getElementById('popup-coupon')?.addEventListener('input', (e) => {
    const el = document.getElementById('preview-popup-coupon');
    if (el) el.textContent = (e.target as HTMLInputElement).value;
  });

  document.getElementById('popup-discount')?.addEventListener('input', (e) => {
    const el = document.getElementById('preview-popup-discount');
    if (el) el.textContent = (e.target as HTMLInputElement).value;
  });

  document.getElementById('cta-text')?.addEventListener('input', (e) => {
    const el = document.getElementById('preview-cta-text');
    if (el) el.textContent = (e.target as HTMLInputElement).value;
  });

  // Save settings
  document.getElementById('save-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('save-btn') as HTMLButtonElement | null;
    const status = document.getElementById('save-status');
    
    if (btn) {
      btn.disabled = true;
      const textEl = btn.querySelector('.btn-text') as HTMLElement | null;
      const loadingEl = btn.querySelector('.btn-loading') as HTMLElement | null;
      if (textEl) textEl.hidden = true;
      if (loadingEl) loadingEl.hidden = false;
    }

    try {
      const { createClient } = await import('@supabase/supabase-js');
      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      // Collect all settings
      const inputs = document.querySelectorAll('[data-key]');
      const updates: Promise<any>[] = [];

      inputs.forEach((input) => {
        const el = input as HTMLElement;
        const key = el.dataset.key;
        const category = el.dataset.category;
        const inputType = (input as HTMLInputElement).type;
        const categoryMap: Record<string, string> = {
          'countdown': 'countdown', 'popup': 'popup',
          'social': 'social-proof', 'sticky': 'sticky-cta'
        };
        const resolvedCategory = category || categoryMap[key?.split('_')[0] || ''] || 'general';
        let value: any;

        if (inputType === 'checkbox') {
          value = JSON.stringify((input as HTMLInputElement).checked);
        } else if (inputType === 'datetime-local') {
          const val = (input as HTMLInputElement).value;
          value = val ? JSON.stringify(new Date(val).toISOString()) : JSON.stringify(null);
        } else {
          value = JSON.stringify((input as HTMLInputElement).value);
        }

        updates.push(
          Promise.resolve(
            supabase
              .from('marketing_settings')
              .upsert({ key, value, category: resolvedCategory, updated_at: new Date().toISOString() }, { onConflict: 'key' })
              .select()
          )
        );
      });

      await Promise.all(updates);

      if (status) {
        status.textContent = '✓ Configuración guardada';
        status.classList.add('visible');
        setTimeout(() => status.classList.remove('visible'), 3000);
      }
    } catch (err: any) {
      if (status) {
        status.textContent = '✗ Error: ' + err.message;
        status.style.color = 'var(--color-error)';
        status.classList.add('visible');
      }
    }

    if (btn) {
      btn.disabled = false;
      const textEl = btn.querySelector('.btn-text') as HTMLElement | null;
      const loadingEl = btn.querySelector('.btn-loading') as HTMLElement | null;
      if (textEl) textEl.hidden = false;
      if (loadingEl) loadingEl.hidden = true;
    }
  });
</script>
