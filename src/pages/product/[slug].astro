---
/**
 * [slug].astro
 * Página de detalle de producto con diseño moderno
 * 
 * @see https://docs.astro.build/en/guides/routing/#dynamic-routes
 */

export const prerender = false;

import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import PageLayout from '../../layouts/PageLayout.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import WishlistButton from '../../components/WishlistButton.astro';
import { supabase } from '../../lib/supabase';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/shop');

const { data: product, error } = await supabase
  .from('products')
  .select(`
    id,
    name,
    slug,
    description,
    short_description,
    price,
    compare_price,
    sku,
    stock,
    images,
    weight,
    featured,
    status,
    product_categories:category_id (
      name,
      slug
    ),
    product_reviews (
      rating,
      title,
      comment,
      approved,
      created_at,
      customers:customer_id (
        full_name
      )
    )
  `)
  .eq('slug', slug!)
  .single();

if (error || !product) {
  return Astro.redirect('/shop');
}

const categories = product.product_categories as any;
const catSlug = Array.isArray(categories) ? categories[0]?.slug : categories?.slug;
const catName = Array.isArray(categories) ? categories[0]?.name : categories?.name;
const catId = Array.isArray(categories) ? categories[0]?.id : categories?.id;

const hasDiscount = product.compare_price && product.compare_price > product.price;
const isLowStock = product.stock > 0 && product.stock <= 5;
const discount = hasDiscount
  ? Math.round(((product.compare_price! - product.price) / product.compare_price!) * 100)
  : 0;

const formatPrice = (p: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(p);
const formattedPrice = formatPrice(product.price);
const formattedComparePrice = hasDiscount ? formatPrice(product.compare_price!) : null;

const approvedReviews = product.product_reviews?.filter((r: any) => r.approved) || [];
const avgRating = approvedReviews.length > 0
  ? approvedReviews.reduce((sum: number, r: any) => sum + r.rating, 0) / approvedReviews.length
  : 0;

const images = product.images || [];
const mainImage = images[0] || '/placeholder-product.svg';

// Product features (simulated - you can add these to your DB)
const features = [
  { icon: '🚚', title: 'Envío gratis', desc: 'En compras mayores a $500' },
  { icon: '🔒', title: 'Pago seguro', desc: 'Transacción 100% segura' },
  { icon: '↩️', title: 'Devolución', desc: '30 días de garantía' },
  { icon: '💬', title: 'Soporte', desc: 'Atención 24/7' },
];

// JSON-LD Structured Data for Google Rich Snippets
// @see https://developers.google.com/search/docs/appearance/structured-data/product
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.short_description || product.description?.slice(0, 500),
  image: mainImage.startsWith('http') ? mainImage : new URL(mainImage, Astro.url).toString(),
  url: Astro.url.toString(),
  sku: product.sku || undefined,
  brand: {
    '@type': 'Brand',
    name: 'La cueva del Troll',
  },
  offers: {
    '@type': 'Offer',
    url: Astro.url.toString(),
    priceCurrency: 'MXN',
    price: product.price,
    priceValidUntil: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
    itemCondition: 'https://schema.org/NewCondition',
    availability: product.stock > 0
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
  },
  ...(approvedReviews.length > 0 && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: avgRating.toFixed(1),
      reviewCount: approvedReviews.length,
      bestRating: '5',
      worstRating: '1',
    },
  }),
};
---

<PageLayout
  title={`${product.name} | La cueva del Troll`}
  description={product.short_description || product.description?.slice(0, 160)}
  image={`/api/og/${slug}.png`}
>

  <!-- JSON-LD Structured Data for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="product-page" transition:animate="fade">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Inicio</a></li>
        <li><a href="/shop">Tienda</a></li>
        {catName && (
          <li><a href={`/shop?category=${catSlug}`}>{catName}</a></li>
        )}
        <li class="active">{product.name}</li>
      </ol>
    </nav>

    <!-- Main Product Section -->
    <section class="product-main">
      <!-- Gallery -->
      <div class="gallery">
        <div class="gallery-main" id="gallery-main">
          <Image src={mainImage} alt={product.name} class="gallery-main-image" id="main-image" width={600} height={600} sizes="(max-width: 768px) 100vw, 50vw" loading="eager" />
          {hasDiscount && (
            <span class="badge-discount">-{discount}%</span>
          )}
          {product.featured && (
            <span class="badge-featured">⭐ Destacado</span>
          )}
          <button class="gallery-zoom" id="zoom-btn" aria-label="Ampliar imagen">
            <Icon name="zoom-in" width="24" height="24" />
          </button>
        </div>

        {images.length > 1 && (
          <div class="gallery-thumbnails">
            {images.map((img: string, i: number) => (
              <button
                class:list={['thumb', { active: i === 0 }]}
                data-image={img}
                aria-label={`Imagen ${i + 1} de ${product.name}`}
              >
                <Image src={img} alt={`${product.name} - Miniatura ${i + 1}`} width={80} height={80} sizes="80px" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Product Info -->
      <div class="product-info">
        <!-- Header -->
        <header class="info-header">
          {catName && (
            <a href={`/shop?category=${catSlug}`} class="product-category">
              {catName}
            </a>
          )}
          <h1 class="product-title">{product.name}</h1>
          
          {avgRating > 0 && (
            <div class="product-rating">
              <div class="rating-stars">
                {[1, 2, 3, 4, 5].map(star => (
                  <span class:list={['star', { filled: star <= Math.round(avgRating) }]}>★</span>
                ))}
              </div>
              <span class="rating-value">{avgRating.toFixed(1)}</span>
              <span class="rating-count">({approvedReviews.length} reseñas)</span>
            </div>
          )}
        </header>

        <!-- Price -->
        <div class="info-price">
          <div class="price-main">
            <span class="price-current">{formattedPrice}</span>
            {formattedComparePrice && (
              <span class="price-original">{formattedComparePrice}</span>
            )}
          </div>
          {hasDiscount && (
            <span class="price-save">Ahorras {formatPrice(product.compare_price! - product.price)}</span>
          )}
        </div>

        <!-- Short Description -->
        {product.short_description && (
          <p class="product-description-short">{product.short_description}</p>
        )}

        <!-- Stock Status -->
        <div class="stock-status">
          <span class:list={['stock-indicator', { 'in-stock': product.stock > 0, 'out-of-stock': product.stock === 0 }]}></span>
          <span class="stock-text">
            {product.stock > 0 
              ? `Disponible (${product.stock} en stock)` 
              : 'Agotado'}
          </span>
        </div>

        <!-- Add to Cart -->
        <div class="add-to-cart-box">
          <div class="purchase-row">
            <div class="quantity-control" aria-label="Seleccionar cantidad">
              <button class="qty-btn" id="qty-decrease" aria-label="Disminuir cantidad" type="button">
                <Icon name="minus" width="18" height="18" />
              </button>
              <input
                type="number"
                id="quantity"
                value="1"
                min="1"
                max={product.stock}
                class="qty-input"
                aria-label="Cantidad"
              />
              <button class="qty-btn" id="qty-increase" aria-label="Aumentar cantidad" type="button">
                <Icon name="plus" width="18" height="18" />
              </button>
            </div>

            <button
              class="btn-add-cart"
              id="add-to-cart-btn"
              type="button"
              disabled={product.stock === 0}
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-slug={product.slug}
              data-product-price={product.price}
              data-product-image={mainImage}
            >
              <Icon name="shopping-bag" width="20" height="20" />
              <span class="btn-text">{product.stock > 0 ? 'Agregar al carrito' : 'Agotado'}</span>
            </button>

            <WishlistButton productId={product.id} productName={product.name} size="lg" />
          </div>

          {product.stock > 0 && (
            <div class="purchase-meta">
              <span class="purchase-total">Subtotal: <strong id="purchase-subtotal">{formatPrice(product.price)}</strong></span>
              {isLowStock && (
                <span class="urgency-hint">🔥 Solo quedan {product.stock}</span>
              )}
            </div>
          )}
        </div>

        <!-- Trust Badges -->
        <div class="trust-badges">
          <div class="trust-badge">
            <span class="badge-icon">🚚</span>
            <div class="badge-info">
              <span class="badge-title">Envío gratis</span>
              <span class="badge-desc">Compras +$500</span>
            </div>
          </div>
          <div class="trust-badge">
            <span class="badge-icon">🔒</span>
            <div class="badge-info">
              <span class="badge-title">Pago seguro</span>
              <span class="badge-desc">MercadoPago</span>
            </div>
          </div>
          <div class="trust-badge">
            <span class="badge-icon">↩️</span>
            <div class="badge-info">
              <span class="badge-title">Devolución</span>
              <span class="badge-desc">30 días</span>
            </div>
          </div>
        </div>

        <!-- Product Meta -->
        <div class="product-meta-grid">
          {product.sku && (
            <div class="meta-item">
              <span class="meta-icon">📦</span>
              <div>
                <span class="meta-label">SKU</span>
                <span class="meta-value">{product.sku}</span>
              </div>
            </div>
          )}
          {product.weight && (
            <div class="meta-item">
              <span class="meta-icon">⚖️</span>
              <div>
                <span class="meta-label">Peso</span>
                <span class="meta-value">{product.weight}g</span>
              </div>
            </div>
          )}
          <div class="meta-item">
            <span class="meta-icon">🏷️</span>
            <div>
              <span class="meta-label">Categoría</span>
              <span class="meta-value">{catName || 'General'}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tabs Section -->
    <section class="product-tabs">
      <div class="tabs-header">
        <button class="tab-btn active" data-tab="description">Descripción</button>
        <button class="tab-btn" data-tab="specs">Especificaciones</button>
        <button class="tab-btn" data-tab="reviews">Reseñas ({approvedReviews.length})</button>
      </div>
      
      <div class="tabs-content">
        <!-- Description Tab -->
        <div class="tab-panel active" id="tab-description">
          <div class="description-content">
            {product.description || product.short_description || 'No hay descripción disponible.'}
          </div>
        </div>

        <!-- Specs Tab -->
        <div class="tab-panel" id="tab-specs">
          <table class="specs-table">
            <tbody>
              {product.sku && (
                <tr>
                  <td class="spec-label">SKU</td>
                  <td class="spec-value">{product.sku}</td>
                </tr>
              )}
              {product.weight && (
                <tr>
                  <td class="spec-label">Peso</td>
                  <td class="spec-value">{product.weight}g</td>
                </tr>
              )}
              <tr>
                <td class="spec-label">Categoría</td>
                <td class="spec-value">{catName || 'General'}</td>
              </tr>
              <tr>
                <td class="spec-label">Disponibilidad</td>
                <td class="spec-value">{product.stock > 0 ? 'En stock' : 'Agotado'}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Reviews Tab -->
        <div class="tab-panel" id="tab-reviews">
          {approvedReviews.length > 0 ? (
            <div class="reviews-summary">
              <div class="rating-big">
                <span class="rating-number">{avgRating.toFixed(1)}</span>
                <div class="rating-stars-big">
                  {[1, 2, 3, 4, 5].map(star => (
                    <span class:list={['star-big', { filled: star <= Math.round(avgRating) }]}>★</span>
                  ))}
                </div>
                <span class="rating-total">{approvedReviews.length} reseñas</span>
              </div>
            </div>
            
            <div class="reviews-list">
              {approvedReviews.map((review: any) => (
                <article class="review-card">
                  <div class="review-header">
                    <div class="review-avatar">
                      {(review.customers?.full_name || 'A')[0].toUpperCase()}
                    </div>
                    <div class="review-meta">
                      <span class="review-author">{review.customers?.full_name || 'Anónimo'}</span>
                      <div class="review-stars">
                        {[1, 2, 3, 4, 5].map(star => (
                          <span class:list={['star-small', { filled: star <= review.rating }]}>★</span>
                        ))}
                      </div>
                    </div>
                    <time class="review-date" datetime={review.created_at}>
                      {new Date(review.created_at).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </time>
                  </div>
                  {review.title && <h4 class="review-title">{review.title}</h4>}
                  {review.comment && <p class="review-text">{review.comment}</p>}
                </article>
              ))}
            </div>
          ) : (
            <div class="no-reviews">
              <span class="no-reviews-icon">💬</span>
              <h3>Sin reseñas aún</h3>
              <p>¡Sé el primero en opinar!</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
      {features.map(feature => (
        <div class="feature-card">
          <span class="feature-icon">{feature.icon}</span>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.desc}</p>
        </div>
      ))}
    </section>
  </div>

  <!-- Sticky Add to Cart (Mobile) -->
  <div class="sticky-add-to-cart" id="sticky-bar">
    <div class="sticky-info">
      <Image src={mainImage} alt={product.name} class="sticky-image" width={48} height={48} sizes="48px" loading="lazy" />
      <div class="sticky-details">
        <span class="sticky-name">{product.name}</span>
        <span class="sticky-price">{formattedPrice}</span>
      </div>
    </div>
    <button 
      class="sticky-btn"
      disabled={product.stock === 0}
      data-product-id={product.id}
      data-product-name={product.name}
      data-product-slug={product.slug}
      data-product-price={product.price}
      data-product-image={mainImage}
    >
      {product.stock > 0 ? 'Agregar' : 'Agotado'}
    </button>
  </div>

  <!-- Related Products -->
  <RelatedProducts
    categoryId={catId}
    currentProductId={product.id}
    limit={4}
  />

  <!-- Recently Viewed -->
  <RecentlyViewed excludeProductId={product.id} limit={8} />

</PageLayout>

<style>
  .product-page {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-6);
  }

  /* Breadcrumb */
  .breadcrumb {
    margin-bottom: var(--space-8);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb-list li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-2);
    color: var(--color-border);
  }

  .breadcrumb-list a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-list a:hover {
    color: var(--color-primary);
  }

  .breadcrumb-list .active {
    color: var(--color-text);
  }

  /* Product Main */
  .product-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  @media (max-width: 900px) {
    .product-main {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* Gallery */
  .gallery {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .gallery-main {
    position: relative;
    aspect-ratio: 1;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }

  .gallery-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-discount {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 11;
    padding: var(--space-2) var(--space-4);
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    color: white;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
  }

  .badge-featured {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 11;
    padding: var(--space-2) var(--space-4);
    background: linear-gradient(135deg, var(--color-primary) 0%, #22c55e 100%);
    color: white;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    border-radius: var(--radius-lg);
  }

  .gallery-zoom {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    z-index: 11;
    width: 48px;
    height: 48px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    border: none;
    border-radius: var(--radius-lg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    backdrop-filter: blur(8px);
  }

  .gallery-zoom:hover {
    background: var(--color-primary);
    transform: scale(1.1);
  }

  .gallery-thumbnails {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-2);
  }

  .thumb {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    transition: all var(--transition-fast);
  }

  .thumb:hover,
  .thumb.active {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Product Info */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .info-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .product-category {
    display: inline-flex;
    align-self: flex-start;
    padding: var(--space-1) var(--space-3);
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .product-category:hover {
    background: var(--color-primary);
    color: white;
  }

  .product-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .rating-stars {
    display: flex;
    gap: 2px;
  }

  .star {
    color: var(--color-border);
    font-size: 1.25rem;
  }

  .star.filled {
    color: #fbbf24;
  }

  .rating-value {
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .rating-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Price — panel destacado */
  .info-price {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-5) var(--space-6);
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.1) 0%, rgba(76, 175, 80, 0.03) 100%);
    border: 1px solid rgba(76, 175, 80, 0.25);
    border-radius: var(--radius-xl);
  }

  .price-main {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .price-current {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--font-bold);
    color: var(--color-primary);
  }

  .price-original {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .price-save {
    padding: var(--space-1) var(--space-3);
    background: var(--color-success-light);
    color: var(--color-success);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-full);
  }

  .product-description-short {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Stock */
  .stock-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .stock-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .stock-indicator.in-stock {
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
    animation: pulse 2s infinite;
  }

  .stock-indicator.out-of-stock {
    background: #ef4444;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .stock-text {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
