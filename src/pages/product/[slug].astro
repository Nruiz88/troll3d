</style>

<script>
  import { addToCart } from '../../lib/cart';

  // Quantity controls + subtotal dinámico
  const qtyInput = document.getElementById('quantity') as HTMLInputElement;
  const qtyDecrease = document.getElementById('qty-decrease')!;
  const qtyIncrease = document.getElementById('qty-increase')!;
  const subtotalEl = document.getElementById('purchase-subtotal');
  const addBtn = document.getElementById('add-to-cart-btn');
  const unitPrice = parseFloat((addBtn as HTMLElement)?.dataset.productPrice ?? '0');
  const fmt = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });

  function updateSubtotal() {
    if (!subtotalEl || !qtyInput) return;
    const qty = parseInt(qtyInput.value) || 1;
    subtotalEl.textContent = fmt.format(unitPrice * qty);
  }

  qtyDecrease?.addEventListener('click', () => {
    const current = parseInt(qtyInput.value) || 1;
    if (current > 1) qtyInput.value = (current - 1).toString();
    updateSubtotal();
  });

  qtyIncrease?.addEventListener('click', () => {
    const current = parseInt(qtyInput.value) || 1;
    const max = parseInt(qtyInput.max) || 99;
    if (current < max) qtyInput.value = (current + 1).toString();
    updateSubtotal();
  });

  qtyInput?.addEventListener('input', updateSubtotal);

  // Add to cart functionality
  async function handleAddToCart(btn: HTMLButtonElement) {
    const quantity = parseInt(qtyInput.value) || 1;
    const originalText = btn.querySelector('.btn-text')?.textContent || btn.textContent;

    btn.disabled = true;
    if (btn.querySelector('.btn-text')) {
      (btn.querySelector('.btn-text') as HTMLElement).textContent = 'Agregando...';
    } else {
      btn.textContent = 'Agregando...';
    }

    await addToCart({
      id: btn.dataset.productId!,
      name: btn.dataset.productName!,
      slug: btn.dataset.productSlug!,
      price: parseFloat(btn.dataset.productPrice!),
      images: [btn.dataset.productImage!],
      quantity,
    });

    btn.classList.add('added');
    if (btn.querySelector('.btn-text')) {
      (btn.querySelector('.btn-text') as HTMLElement).textContent = '✓ Agregado';
    } else {
      btn.textContent = '✓ Agregado';
    }
    window.dispatchEvent(new Event('cart-updated'));
    window.dispatchEvent(new Event('open-cart'));

    setTimeout(() => {
      btn.classList.remove('added');
      if (btn.querySelector('.btn-text')) {
        (btn.querySelector('.btn-text') as HTMLElement).textContent = originalText;
      } else {
        btn.textContent = originalText;
      }
      btn.disabled = false;
    }, 2000);
  }

  document.querySelectorAll('.btn-add-cart, .sticky-btn').forEach(btn => {
    btn.addEventListener('click', () => handleAddToCart(btn as HTMLButtonElement));
  });

  // Thumbnail gallery
  const mainImg = document.getElementById('main-image') as HTMLImageElement;
  document.querySelectorAll('.thumb').forEach(thumb => {
    thumb.addEventListener('click', () => {
      const img = thumb as HTMLButtonElement;
      mainImg.src = img.dataset.image!;
      document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
    });
  });

  // Tabs
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(`tab-${(btn as HTMLElement).dataset.tab}`)?.classList.add('active');
    });
  });

  // Sticky add to cart bar
  const stickyBar = document.getElementById('sticky-bar');
  const addToCartBtn = document.getElementById('add-to-cart-btn');

  window.addEventListener('scroll', () => {
    if (addToCartBtn) {
      const rect = addToCartBtn.getBoundingClientRect();
      if (rect.bottom < 0) {
        stickyBar?.classList.add('visible');
      } else {
        stickyBar?.classList.remove('visible');
      }
    }
  });

  // Zoom button
  document.getElementById('zoom-btn')?.addEventListener('click', () => {
    window.open(mainImg.src, '_blank');
  });

  // Track product as recently viewed
  const productId = document.querySelector('[data-product-id]')?.getAttribute('data-product-id');
  if (productId && typeof (window as any).addToRecentlyViewed === 'function') {
    (window as any).addToRecentlyViewed(productId);
  }
</script>
