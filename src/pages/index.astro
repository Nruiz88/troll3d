<script>
  // Recent products slider
  const recentScroll = document.getElementById('recent-scroll');
  const recentPrev = document.getElementById('recent-prev') as HTMLButtonElement | null;
  const recentNext = document.getElementById('recent-next') as HTMLButtonElement | null;

  if (recentScroll && recentPrev && recentNext) {
    const step = () => {
      const item = recentScroll.querySelector('.recent-scroll-item') as HTMLElement | null;
      return item ? item.getBoundingClientRect().width + 20 : 320;
    };

    const updateButtons = () => {
      const max = recentScroll.scrollWidth - recentScroll.clientWidth;
      recentPrev.disabled = recentScroll.scrollLeft <= 0;
      recentNext.disabled = recentScroll.scrollLeft >= max - 1;
      recentPrev.style.display = max <= 0 ? 'none' : '';
      recentNext.style.display = max <= 0 ? 'none' : '';
    };

    recentPrev.addEventListener('click', () => recentScroll.scrollBy({ left: -step(), behavior: 'smooth' }));
    recentNext.addEventListener('click', () => recentScroll.scrollBy({ left: step(), behavior: 'smooth' }));
    recentScroll.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    updateButtons();
  }

  // Newsletter form
  document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const input = (e.target as HTMLFormElement).querySelector('input') as HTMLInputElement;
    const btn = (e.target as HTMLFormElement).querySelector('button') as HTMLButtonElement;
    
    btn.textContent = 'Suscribiendo...';
    btn.disabled = true;
    
    // Simulate API call
    await new Promise(resolve => setTimeout(resolve, 1500));
    
    btn.textContent = '✓ Suscrito';
    btn.style.background = '#22c55e';
    input.value = '';
    
    setTimeout(() => {
      btn.textContent = 'Suscribirme';
      btn.style.background = '';
      btn.disabled = false;
    }, 3000);
  });
</script>
