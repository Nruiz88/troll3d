---
/**
 * index.astro
 * Home page premium - La cueva del Troll
 * Diseño prioritario: Categorías → Productos Destacados → Lo Nuevo
 * 
 * @see https://www.nngroup.com/articles/e-commerce-homepages/
 */

import PageLayout from '../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import CategoryShowcase from '../components/CategoryShowcase.astro';
import ProductCardV2 from '../components/ProductCardV2.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import CountdownTimer from '../components/CountdownTimer.astro';
import SocialProof from '../components/SocialProof.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { Image } from 'astro:assets';
import { supabase } from '../lib/supabase';

// Obtener productos destacados
const { data: featuredProducts } = await supabase
  .from('products')
  .select(`
    id,
    name,
    slug,
    price,
    compare_price,
    short_description,
    description,
    images,
    featured,
    stock,
    sku,
    product_categories:category_id ( name, slug )
  `)
  .eq('status', 'active')
  .eq('featured', true)
  .order('created_at', { ascending: false })
  .limit(4);

// Obtener categorías
const { data: categories } = await supabase
  .from('product_categories')
  .select('id, name, slug, description, image_url, emoji')
  .order('sort_order', { ascending: true })
  .limit(6);

// Obtener productos recientes
const { data: recentProducts } = await supabase
  .from('products')
  .select(`
    id,
    name,
    slug,
    price,
    compare_price,
    short_description,
    images,
    featured,
    stock,
    product_categories:category_id ( name, slug )
  `)
  .eq('status', 'active')
  .order('created_at', { ascending: false })
  .limit(8);

// Formatear categoría
const formatCategory = (cat: any) => cat?.name || 'Sin categoría';

// Formatear precio
const formatPrice = (price: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(price);
---

<PageLayout
  title="La cueva del Troll | Productos únicos de alta calidad"
  description="Descubre productos únicos, diseños exclusivos y creaciones que no encontrarás en ningún otro lugar. Envío rápido y pago seguro."
>

  <!-- ============================================
       HERO SECTION - Principal llamada a la acción
       ============================================ -->
  <section class="hero" transition:animate="fade">
    <div class="hero-container">
      <div class="hero-content">
        <span class="hero-badge">✨ Colección 2026</span>
        <h1 class="hero-title">
          Productos <span class="gradient-text">únicos</span> que no encontrarás en ningún otro lugar
        </h1>
        <p class="hero-subtitle">
          Diseños exclusivos, materiales de primera calidad y acabados perfectos. 
          Cada pieza es una obra de arte única.
        </p>
        <div class="hero-actions">
          <a href="/shop" class="btn-primary">
            Explorar la tienda
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/about" class="btn-secondary">
            Nuestra historia
          </a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">500+</span>
            <span class="stat-label">Productos vendidos</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">4.9★</span>
            <span class="stat-label">Calificación promedio</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">24h</span>
            <span class="stat-label">Envío express</span>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="visual-card card-1">
          <div class="card-glow"></div>
          <span class="card-emoji">⚔️</span>
          <span class="card-text">Espadas</span>
        </div>
        <div class="visual-card card-2">
          <div class="card-glow"></div>
          <span class="card-emoji">🛡️</span>
          <span class="card-text">Escudos</span>
        </div>
        <div class="visual-card card-3">
          <div class="card-glow"></div>
          <span class="card-emoji">🐉</span>
          <span class="card-text">Dragones</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       FEATURES BAR - Beneficios clave
       ============================================ -->
  <section class="features-bar" transition:animate="fade">
    <div class="features-container">
      <div class="feature-item">
        <div class="feature-icon">🚚</div>
        <div class="feature-text">
          <strong>Envío gratis</strong>
          <span>En compras +$500</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon">🔒</div>
        <div class="feature-text">
          <strong>Pago 100% seguro</strong>
          <span>MercadoPago protegido</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon">↩️</div>
        <div class="feature-text">
          <strong>30 días de garantía</strong>
          <span>Devolución sin preguntas</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon">✨</div>
        <div class="feature-text">
          <strong>Calidad premium</strong>
          <span>Materiales de primera</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       COUNTDOWN - Oferta especial
       ============================================ -->
  <section class="section section-countdown">
    <div class="container">
      <CountdownTimer label="🔥 ¡Oferta de bienvenida termina en!" />
    </div>
  </section>

  <!-- ============================================
       CATEGORIES - Explorar por categoría (PRIORITARIO)
       ============================================ -->
  {categories && categories.length > 0 && (
    <CategoryShowcase 
      categories={categories}
      title="Explora nuestras categorías"
      subtitle="Encuentra exactamente lo que buscas"
    />
  )}

  <!-- ============================================
       FEATURED PRODUCTS - Lo más vendido (Premium Layout)
       ============================================ -->
  {featuredProducts && featuredProducts.length > 0 && (
    <section class="section-featured">
      <div class="featured-container">
        <!-- Header -->
        <div class="featured-header">
          <div class="featured-header-content">
            <span class="featured-badge">⭐ Los más queridos</span>
            <h2 class="featured-title">Productos destacados</h2>
            <p class="featured-subtitle">Los favoritos de nuestros guerreros. Calidad probada y reseñas reales.</p>
          </div>
          <a href="/shop" class="view-all-link">
            <span>Ver toda la colección</span>
            <Icon name="arrow-right" width="18" height="18" />
          </a>
        </div>

        <!-- Featured Hero Product (first item, large) -->
        {(featuredProducts as any[]).slice(0, 1).map((p: any) => {
          const mainImage = p.images?.[0] || '/placeholder-product.svg';
          const hasDiscount = p.compare_price && p.compare_price > p.price;
          const discount = hasDiscount ? Math.round(((p.compare_price - p.price) / p.compare_price) * 100) : 0;
          const catName = formatCategory(p.product_categories);
          return (
            <a href={`/product/${p.slug}`} class="featured-hero-card">
              <div class="hero-card-image">
                <Image src={mainImage} alt={p.name} width={800} height={500} loading="lazy" class="hero-card-img" />
                <div class="hero-card-overlay"></div>
                <div class="hero-card-badges">
                  {discount > 0 && <span class="badge-discount">-{discount}%</span>}
                  <span class="badge-featured">⭐ Destacado</span>
                </div>
              </div>
              <div class="hero-card-info">
                {catName && <span class="hero-card-category">{catName}</span>}
                <h3 class="hero-card-name">{p.name}</h3>
                {p.short_description && <p class="hero-card-desc">{p.short_description}</p>}
                <div class="hero-card-prices">
                  <span class="hero-price">{formatPrice(p.price)}</span>
                  {hasDiscount && <span class="hero-old-price">{formatPrice(p.compare_price)}</span>}
                </div>
                <div class="hero-card-actions">
                  <span class="hero-cta">
                    Ver producto
                    <Icon name="arrow-right" width="18" height="18" />
                  </span>
                  <div class="hero-trust">
                    <span>🚚 Envío gratis</span>
                    <span>🔒 Pago seguro</span>
                    <span>↩️ 30 días garantía</span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}

        <!-- Remaining featured products as grid -->
        <div class="featured-grid">
          {(featuredProducts as any[]).slice(1).map((p: any) => (
            <ProductCardV2
              id={p.id}
              name={p.name}
              slug={p.slug}
              price={p.price}
              comparePrice={p.compare_price}
              shortDescription={p.short_description}
              images={p.images}
              featured={!!p.featured}
              stock={p.stock}
              sku={p.sku}
              category={formatCategory(p.product_categories)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============================================
       RECENT PRODUCTS - Lo nuevo (Scroll Layout)
       ============================================ -->
  {recentProducts && recentProducts.length > 0 && (
    <section class="section-recent">
      <div class="recent-container">
        <div class="recent-header">
          <div>
            <span class="recent-badge">🆕 Nuevo en la cueva</span>
            <h2 class="recent-title">Lo último que llego</h2>
            <p class="recent-subtitle">Descubre nuestras creaciones más recientes</p>
          </div>
          <a href="/shop" class="view-all-link">
            <span>Ver todo</span>
            <Icon name="arrow-right" width="18" height="18" />
          </a>
        </div>
        <div class="recent-slider">
          <button type="button" class="slider-btn slider-prev" id="recent-prev" aria-label="Ver productos anteriores">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <div class="recent-scroll" id="recent-scroll">
          {(recentProducts as any[]).slice(0, 8).map((p: any, index: number) => (
            <div class="recent-scroll-item" style={`--index: ${index}`}>
              <ProductCardV2
                id={p.id}
                name={p.name}
                slug={p.slug}
                price={p.price}
                comparePrice={p.compare_price}
                shortDescription={p.short_description}
                images={p.images}
                featured={!!p.featured}
                stock={p.stock}
                category={formatCategory(p.product_categories)}
              />
            </div>
          ))}
          </div>
          <button type="button" class="slider-btn slider-next" id="recent-next" aria-label="Ver más productos">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </section>
  )}

  <!-- ============================================
       PROMO BANNER - Oferta especial
       ============================================ -->
  <section class="section section-promo">
    <div class="container">
      <div class="promo-banner">
        <div class="promo-content">
          <span class="promo-badge">🔥 Oferta exclusiva</span>
          <h2 class="promo-title">20% de descuento en tu primera compra</h2>
          <p class="promo-text">Usa el código <strong>TROLL20</strong> en el checkout y obtén un descuento especial</p>
          <a href="/shop" class="btn-primary">
            Aprovechar oferta
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
        <div class="promo-visual">
          <div class="promo-card">
            <span class="promo-discount">-20%</span>
            <span class="promo-code">TROLL20</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       WHY US - Por qué elegirnos
       ============================================ -->
  <section class="section section-why">
    <div class="container">
      <div class="section-header centered">
        <span class="section-label">💎 La diferencia</span>
        <h2 class="section-title">Por qué somos diferentes</h2>
        <p class="section-desc">No somos una tienda más. Somos una experiencia.</p>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">🎨</div>
          <h3 class="why-title">Diseños únicos</h3>
          <p class="why-text">Cada pieza es original. No encontrarás estos diseños en ningún otro lugar del mundo.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">🏆</div>
          <h3 class="why-title">Calidad premium</h3>
          <p class="why-text">Materiales de primera y acabados perfectos. Si no te gusta, te devolvemos tu dinero.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">⚡</div>
          <h3 class="why-title">Envío express</h3>
          <p class="why-text">Pedidos procesados en 24h. Tu producto favorito en tu puerta en tiempo récord.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">🤝</div>
          <h3 class="why-title">Soporte personal</h3>
          <p class="why-text">¿Dudas? ¿Sugerencias? Estamos aquí para ti. Chat en vivo y atención por WhatsApp.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       SOCIAL PROOF - Prueba social
       ============================================ -->
  <section class="section section-social">
    <div class="container">
      <SocialProof />
    </div>
  </section>

  <!-- ============================================
       NEWSLETTER - Captura de emails
       ============================================ -->
  <section class="section section-newsletter">
    <div class="container">
      <div class="newsletter-card">
        <div class="newsletter-content">
          <span class="newsletter-icon">📬</span>
          <h2 class="newsletter-title">Únete a la cueva</h2>
          <p class="newsletter-text">Suscríbete y obtén acceso exclusivo a ofertas, nuevos productos y descuentos especiales</p>
          <form class="newsletter-form" id="newsletter-form">
            <input 
              type="email" 
              placeholder="Tu email guerrero"
              required
              class="newsletter-input"
            />
            <button type="submit" class="newsletter-btn">
              Suscribirme
            </button>
          </form>
          <p class="newsletter-disclaimer">Sin spam. Solo cosas legendarias de la cueva.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Exit Intent Popup -->
  <ExitIntentPopup />

  <!-- Sticky CTA (mobile) -->
  <StickyCTA text="⚔️ Explorar la cueva" href="/shop" />

</PageLayout>

<style>
  /* ============================================
     HERO SECTION
     ============================================ */
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-16) 0;
    background: linear-gradient(135deg, var(--color-bg) 0%, #0f1a0f 50%, var(--color-bg) 100%);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(76, 175, 80, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 87, 34, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-container {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-badge {
    display: inline-flex;
    align-self: flex-start;
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-full);
    animation: fadeInDown 0.6s ease;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: var(--font-bold);
    line-height: 1.1;
    color: var(--color-text);
    margin: 0;
    animation: fadeInUp 0.6s ease 0.1s both;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 500px;
    animation: fadeInUp 0.6s ease 0.2s both;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    animation: fadeInUp 0.6s ease 0.3s both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    background: linear-gradient(135deg, var(--color-primary) 0%, #388e3c 100%);
    color: white;
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 20px rgba(76, 175, 80, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(76, 175, 80, 0.4);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    background: transparent;
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    animation: fadeInUp 0.6s ease 0.4s both;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  /* Hero Visual */
  .hero-visual {
    position: relative;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-card {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-8);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
    transition: all var(--transition-normal);
  }

  .visual-card:hover {
    transform: translateY(-10px) scale(1.05);
  }

  .card-glow {
    position: absolute;
    inset: -2px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    border-radius: inherit;
    z-index: -1;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .visual-card:hover .card-glow {
    opacity: 1;
  }

  .card-emoji {
    font-size: 3rem;
  }

  .card-text {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .card-1 {
    top: 10%;
    left: 10%;
    animation: float 3s ease-in-out infinite;
  }

  .card-2 {
    top: 30%;
    right: 10%;
    animation: float 3s ease-in-out infinite 0.5s;
  }

  .card-3 {
    bottom: 10%;
    left: 30%;
    animation: float 3s ease-in-out infinite 1s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ============================================
     FEATURES BAR
     ============================================ */
  .features-bar {
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .features-container {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-6);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    transition: all var(--transition-fast);
  }

  .feature-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .feature-icon {
    font-size: 1.5rem;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
  }

  .feature-text strong {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .feature-text span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ============================================
     SECTIONS COMMON
     ============================================ */
  .section {
    padding: var(--space-16) 0;
  }

  .container {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    gap: var(--space-4);
  }

  .section-header.centered {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-label {
    display: inline-flex;
    align-self: flex-start;
    padding: var(--space-1) var(--space-3);
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  .section-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin: var(--space-3) 0 0;
    max-width: 500px;
  }

  .section-header.centered .section-desc {
    margin-left: auto;
    margin-right: auto;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .view-all:hover {
    background: var(--color-primary-light);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  /* ============================================
     CATEGORIES
     ============================================ */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4);
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    text-decoration: none;
    text-align: center;
    transition: all var(--transition-normal);
    animation: fadeInUp 0.5s ease both;
  }

  .category-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(76, 175, 80, 0.15);
  }

  .category-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-3);
    transition: transform var(--transition-fast);
  }

  .category-card:hover .category-icon {
    transform: scale(1.2) rotate(-5deg);
  }

  .category-name {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .category-desc {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .category-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }

  .category-card:hover .category-link {
    gap: var(--space-2);
  }

  /* ============================================
     PROMO BANNER
     ============================================ */
  .promo-banner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    padding: var(--space-12);
    background: linear-gradient(135deg, var(--color-bg) 0%, #1a2f1a 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    position: relative;
  }

  .promo-banner::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 87, 34, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .promo-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
    z-index: 1;
  }

  .promo-badge {
    display: inline-flex;
    align-self: flex-start;
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-full);
  }

  .promo-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  .promo-text {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin: 0;
  }

  .promo-text strong {
    color: var(--color-accent);
    font-family: monospace;
    font-size: var(--text-lg);
    padding: var(--space-1) var(--space-2);
    background: rgba(255, 87, 34, 0.1);
    border-radius: var(--radius-md);
  }

  .promo-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .promo-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-8);
    background: linear-gradient(135deg, var(--color-accent) 0%, #e64a19 100%);
    border-radius: var(--radius-2xl);
    box-shadow: 0 20px 40px rgba(255, 87, 34, 0.3);
    animation: pulse 2s infinite;
  }

  .promo-discount {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: var(--font-bold);
    color: white;
    line-height: 1;
  }

  .promo-code {
    font-family: monospace;
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: rgba(255, 255, 255, 0.9);
    padding: var(--space-2) var(--space-4);
    background: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-lg);
    margin-top: var(--space-3);
    letter-spacing: 0.1em;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
  }

  /* ============================================
     WHY US
     ============================================ */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .why-card {
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    text-align: center;
    transition: all var(--transition-normal);
  }

  .why-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(76, 175, 80, 0.15);
  }

  .why-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
  }

  .why-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  .why-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ============================================
     NEWSLETTER
     ============================================ */
  .newsletter-card {
    padding: var(--space-12);
    background: linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-bg) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    text-align: center;
  }

  .newsletter-content {
    max-width: 500px;
    margin: 0 auto;
  }

  .newsletter-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--space-4);
  }

  .newsletter-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  .newsletter-text {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .newsletter-input {
    flex: 1;
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    color: var(--color-text);
    font-size: var(--text-base);
    transition: all var(--transition-fast);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .newsletter-btn {
    padding: var(--space-4) var(--space-6);
    background: linear-gradient(135deg, var(--color-primary) 0%, #388e3c 100%);
    color: white;
    border: none;
    border-radius: var(--radius-xl);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .newsletter-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(76, 175, 80, 0.4);
  }

  .newsletter-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ============================================
     VIEW ALL LINK (shared)
     ============================================ */
  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: rgba(76, 175, 80, 0.1);
    border: 1px solid rgba(76, 175, 80, 0.3);
    border-radius: var(--radius-xl);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all 0.35s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .view-all-link:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(76, 175, 80, 0.3);
  }

  .view-all-link svg {
    transition: transform var(--transition-base);
  }

  .view-all-link:hover svg {
    transform: translateX(4px);
  }

  /* ============================================
     FEATURED PRODUCTS (Premium Layout)
     ============================================ */
  .section-featured {
    padding: var(--space-20) 0;
  }

  .featured-container {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .featured-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .featured-badge {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: rgba(76, 175, 80, 0.12);
    color: var(--color-primary);
    border: 1px solid rgba(76, 175, 80, 0.25);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, var(--text-4xl));
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
    line-height: 1.15;
  }

  .featured-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Hero Card */
  .featured-hero-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    margin-bottom: var(--space-8);
  }

  .featured-hero-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
    box-shadow: 0 20px 50px rgba(76, 175, 80, 0.15), 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .hero-card-image {
    position: relative;
    overflow: hidden;
    min-height: 360px;
  }

  .hero-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .featured-hero-card:hover .hero-card-img {
    transform: scale(1.04);
  }

  .hero-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10, 15, 13, 0.1) 0%, rgba(10, 15, 13, 0.3) 100%);
    pointer-events: none;
  }

  .hero-card-badges {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    display: flex;
    gap: var(--space-2);
  }

  .hero-card-badges .badge-discount {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
    border-radius: var(--radius-md);
    font-size: 12px;
    font-weight: var(--font-bold);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
  }

  .hero-card-badges .badge-featured {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    background: rgba(76, 175, 80, 0.9);
    color: white;
    border-radius: var(--radius-md);
    font-size: 12px;
    font-weight: var(--font-bold);
  }

  .hero-card-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-10);
  }

  .hero-card-category {
    display: inline-block;
    width: fit-content;
    padding: var(--space-1) var(--space-3);
    background: rgba(76, 175, 80, 0.12);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    font-size: 11px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero-card-name {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
    line-height: 1.15;
  }

  .hero-card-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-card-prices {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .hero-price {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-primary);
    line-height: 1;
  }

  .hero-old-price {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .hero-card-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    background: linear-gradient(135deg, var(--color-primary) 0%, #388e3c 100%);
    color: white;
    border-radius: var(--radius-xl);
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    text-align: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(76, 175, 80, 0.3);
    width: fit-content;
  }

  .featured-hero-card:hover .hero-cta {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(76, 175, 80, 0.4);
  }

  .hero-trust {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-trust span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  /* Featured Grid — cards ProductCardV2 */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .featured-grid :global(.product-card-v2) {
    animation: cardReveal 0.6s ease-out both;
  }

  .featured-grid :global(.product-card-v2:nth-child(1)) { animation-delay: 0s; }
  .featured-grid :global(.product-card-v2:nth-child(2)) { animation-delay: 0.08s; }
  .featured-grid :global(.product-card-v2:nth-child(3)) { animation-delay: 0.16s; }

  @keyframes cardReveal {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ============================================
     RECENT PRODUCTS (Scroll Layout)
     ============================================ */
  .section-recent {
    padding: var(--space-20) 0;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-secondary) 50%, var(--color-bg) 100%);
  }

  .recent-container {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .recent-badge {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 87, 34, 0.12);
    color: var(--color-accent);
    border: 1px solid rgba(255, 87, 34, 0.25);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .recent-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, var(--text-4xl));
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
    line-height: 1.15;
  }

  .recent-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Horizontal slider — ProductCardV2 */
  .recent-slider {
    position: relative;
  }

  .recent-scroll {
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-4);
    margin: 0 calc(var(--space-2) * -1);
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .recent-scroll::-webkit-scrollbar {
    display: none;
  }

  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .slider-btn:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .slider-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .slider-prev { left: calc(var(--space-4) * -1); }
  .slider-next { right: calc(var(--space-4) * -1); }

  @media (max-width: 768px) {
    .slider-btn { display: none; }
  }

  .recent-scroll-item {
    flex: 0 0 300px;
    scroll-snap-align: start;
    animation: cardReveal 0.6s ease-out both;
    animation-delay: calc(var(--index, 0) * 0.08s);
    display: flex;
  }

  .recent-scroll-item :global(.product-card-v2) {
    flex: 1;
    width: 100%;
    height: 100%;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-content {
      align-items: center;
    }

    .hero-subtitle {
      margin: 0 auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-stats {
      justify-content: center;
    }

    .hero-visual {
      display: none;
    }

    .features-container {
      grid-template-columns: repeat(2, 1fr);
    }

    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .promo-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .promo-content {
      align-items: center;
    }    .promo-visual {
      display: none;
    }

    .featured-hero-card {
      grid-template-columns: 1fr;
    }

    .hero-card-image {
